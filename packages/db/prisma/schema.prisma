/// Department tree. `path` is the materialised ancestor path "/<root id>/…/<own id>/"
/// (department scope uses it for sub-departments); rewritten by the service on move.
model Department {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  leadUserId  String?              @map("lead_user_id") @db.Uuid
  parentId    String?              @map("parent_id") @db.Uuid
  path        String
  depth       Int                  @default(0)
  budgetCode  String?              @map("budget_code")
  activeFrom  DateTime?            @map("active_from") @db.Date
  activeTo    DateTime?            @map("active_to") @db.Date
  visibility  DepartmentVisibility @default(ORGANISATION)
  createdById String               @map("created_by_id") @db.Uuid
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead                User?                @relation("DepartmentLead", fields: [leadUserId], references: [id], onDelete: Restrict)
  parent              Department?          @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            Department[]         @relation("DepartmentTree")
  createdBy           User                 @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  teams               Team[]
  tasks               Task[]
  events              CampaignEvent[]
  contentItems        ContentItem[]
  budgetLines         FinanceBudgetLine[]
  financeTransactions FinanceTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, leadUserId])
  @@map("departments")
}

model Team {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  departmentId      String             @map("department_id") @db.Uuid
  name              String
  coordinatorUserId String?            @map("coordinator_user_id") @db.Uuid
  geographicUnitId  String?            @map("geographic_unit_id") @db.Uuid
  contactChannel    TeamContactChannel @default(IN_APP) @map("contact_channel")
  /// Internal coordination detail (e.g. group name). Never a public or voter list.
  contactDetail     String?            @map("contact_detail")
  status            TeamStatus         @default(ACTIVE)
  createdById       String             @map("created_by_id") @db.Uuid
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department     Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  coordinator    User?              @relation("TeamCoordinator", fields: [coordinatorUserId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit?    @relation("TeamGeography", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members        TeamMember[]
  tasks          Task[]
  invitedTo      EventInvitedTeam[]
  attendances    EventAttendance[]

  @@unique([tenantId, departmentId, name])
  @@index([tenantId, coordinatorUserId])
  @@index([tenantId, geographicUnitId])
  @@map("teams")
}

/// Membership history: removal sets left_at (one active row per team and user, partial unique index).
model TeamMember {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  teamId      String         @map("team_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        TeamMemberRole @default(MEMBER)
  joinedAt    DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt      DateTime?      @map("left_at") @db.Timestamptz(3)
  addedById   String         @map("added_by_id") @db.Uuid
  removedById String?        @map("removed_by_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user      User   @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy   User   @relation("TeamMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  removedBy User?  @relation("TeamMemberRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, teamId])
  @@map("team_members")
}

