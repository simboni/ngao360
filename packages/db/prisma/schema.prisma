// ============================================================================
// Tenancy, identity and access
// ============================================================================

/// Organisation workspace. Not tenant-owned (it IS the tenant); no RLS.
model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique
  name             String
  displayName      String?      @map("display_name")
  type             TenantType
  status           TenantStatus @default(ACTIVE)
  locale           String       @default("en-KE")
  timezone         String       @default("Africa/Nairobi")
  retentionProfile String       @default("standard") @map("retention_profile")
  dataRegion       String       @default("ke") @map("data_region")
  settings         Json         @default("{}")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  roles                Role[]
  rolePermissions      RolePermission[]
  roleAssignments      RoleAssignment[]
  sessions             Session[]
  mfaFactors           MfaFactor[]
  auditEvents          AuditEvent[]
  electionCycles       ElectionCycle[]
  geographicUnits      GeographicUnit[]
  registryVersions     RegistryVersion[]
  registryImports      RegistryImport[]
  pollingStations      PollingStation[]
  tallyCentres         TallyCentre[]
  contests             Contest[]
  candidateReferences  CandidateReference[]
  formTemplates        FormTemplate[]
  storedFiles          StoredFile[]
  resultSubmissions    ResultSubmission[]
  resultValues         ResultValue[]
  resultValueChanges   ResultValueChange[]
  ocrExtractions       OcrExtraction[]
  validationResults    ValidationResult[]
  verifications        Verification[]
  discrepancyCases     DiscrepancyCase[]
  discrepancyCaseLinks DiscrepancyCaseSubmission[]
  discrepancyActions   DiscrepancyCaseAction[]
  tallySnapshots       TallySnapshot[]
  tallyExports         TallyExport[]
  incidents            Incident[]
  notifications        Notification[]
  referenceSequences   ReferenceSequence[]

  modules                   TenantModule[]
  institutions              Institution[]
  correspondence            Correspondence[]
  correspondenceAttachments CorrespondenceAttachment[]
  appointments              Appointment[]
  meetings                  Meeting[]
  meetingActionItems        MeetingActionItem[]
  meetingDecisions          MeetingDecision[]
  citizenCases              CitizenCase[]
  citizenCaseContacts       CitizenCaseContact[]
  caseEvents                CaseEvent[]
  caseReferrals             CaseReferral[]
  projects                  Project[]
  projectMilestones         ProjectMilestone[]
  projectEvidence           ProjectEvidence[]

  @@map("tenants")
}

model User {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  email                   String
  phone                   String?
  displayName             String     @map("display_name")
  passwordHash            String?    @map("password_hash")
  status                  UserStatus @default(INVITED)
  mfaEnabled              Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt             DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount        Int        @default(0) @map("failed_login_count")
  lockedUntil             DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// Consecutive wrong TOTP codes; reaching MFA_MAX_FAILURES sets mfaLockedUntil.
  failedMfaCount          Int        @default(0) @map("failed_mfa_count")
  mfaLockedUntil          DateTime?  @map("mfa_locked_until") @db.Timestamptz(3)
  /// SHA-256 of the single-use invitation token (the raw token is shown once).
  invitationTokenHash     String?    @unique @map("invitation_token_hash")
  invitationExpiresAt     DateTime?  @map("invitation_expires_at") @db.Timestamptz(3)
  invitedById             String?    @map("invited_by_id") @db.Uuid
  passwordChangedAt       DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  privacyNoticeVersion    String?    @map("privacy_notice_version")
  privacyNoticeAcceptedAt DateTime?  @map("privacy_notice_accepted_at") @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy          User?            @relation("UserInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers       User[]           @relation("UserInviter")
  roleAssignments    RoleAssignment[] @relation("AssignmentUser")
  grantedAssignments RoleAssignment[] @relation("AssignmentGrantedBy")
  revokedAssignments RoleAssignment[] @relation("AssignmentRevokedBy")
  sessions           Session[]
  mfaFactors         MfaFactor[]
  auditEvents        AuditEvent[]
  notifications      Notification[]

  uploadedFiles           StoredFile[]            @relation("FileUploader")
  submissions             ResultSubmission[]      @relation("SubmissionSubmitter")
  confirmedValues         ResultValue[]           @relation("ValueConfirmedBy")
  valueChanges            ResultValueChange[]     @relation("ValueChangeActor")
  verifications           Verification[]          @relation("VerificationReviewer")
  supervisedVerifications Verification[]          @relation("VerificationSupervisor")
  assignedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyAssignee")
  openedDiscrepancies     DiscrepancyCase[]       @relation("DiscrepancyOpener")
  resolvedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyResolver")
  approvedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyClosureApprover")
  discrepancyActions      DiscrepancyCaseAction[]
  createdSnapshots        TallySnapshot[]         @relation("SnapshotCreator")
  releasedSnapshots       TallySnapshot[]         @relation("SnapshotReleaser")
  createdExports          TallyExport[]
  approvedTemplates       FormTemplate[]          @relation("TemplateApprover")
  createdTemplates        FormTemplate[]          @relation("TemplateCreator")
  approvedRegistries      RegistryVersion[]       @relation("RegistryApprover")
  registryImports         RegistryImport[]        @relation("RegistryImporter")
  reportedIncidents       Incident[]              @relation("IncidentReporter")
  assignedIncidents       Incident[]              @relation("IncidentAssignee")

  // NGAO360 Office
  updatedModules             TenantModule[]             @relation("ModuleUpdater")
  assignedCorrespondence     Correspondence[]           @relation("CorrespondenceAssignee")
  createdCorrespondence      Correspondence[]           @relation("CorrespondenceCreator")
  correspondenceAttachments  CorrespondenceAttachment[] @relation("CorrespondenceAttachmentAdder")
  assignedAppointments       Appointment[]              @relation("AppointmentAssignee")
  createdAppointments        Appointment[]              @relation("AppointmentCreator")
  ownedMeetings              Meeting[]                  @relation("MeetingOwner")
  minutedMeetings            Meeting[]                  @relation("MeetingMinutesRecorder")
  meetingActionItems         MeetingActionItem[]        @relation("MeetingActionOwner")
  meetingDecisions           MeetingDecision[]          @relation("MeetingDecisionRecorder")
  assignedCases              CitizenCase[]              @relation("CaseAssignee")
  triagedCases               CitizenCase[]              @relation("CaseTriager")
  resolvedCases              CitizenCase[]              @relation("CaseResolutionProposer")
  closedCases                CitizenCase[]              @relation("CaseCloser")
  createdCases               CitizenCase[]              @relation("CaseCreator")
  caseEvents                 CaseEvent[]                @relation("CaseEventActor")
  caseReferrals              CaseReferral[]             @relation("CaseReferrer")
  trackedProjects            Project[]                  @relation("ProjectTrackingOfficer")
  createdProjects            Project[]                  @relation("ProjectCreator")
  reportedProjectCompletions Project[]                  @relation("ProjectCompletionReporter")
  verifiedProjectCompletions Project[]                  @relation("ProjectCompletionVerifier")
  verifiedProjectExpenditure Project[]                  @relation("ProjectExpenditureVerifier")
  publishedProjects          Project[]                  @relation("ProjectPublisher")
  verifiedMilestones         ProjectMilestone[]         @relation("MilestoneVerifier")
  uploadedProjectEvidence    ProjectEvidence[]          @relation("EvidenceUploader")
  verifiedProjectEvidence    ProjectEvidence[]          @relation("EvidenceVerifier")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

/// Tenant-scoped role. System roles (is_system) are seeded from packages/shared SYSTEM_ROLES.
model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  name         String
  description  String   @default("")
  restrictions String?
  isSystem     Boolean  @default(false) @map("is_system")
  mfaRequired  Boolean  @default(false) @map("mfa_required")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// Global permission catalogue (not tenant-owned). Synced from packages/shared PERMISSION_DEFINITIONS.
model Permission {
  key         String  @id
  module      String
  action      String
  description String
  highRisk    Boolean @default(false) @map("high_risk")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

/// A grant of a role to a user, optionally limited by geography, election cycle and time.
model RoleAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  scopeType        ScopeType @default(ORGANISATION) @map("scope_type")
  geographicUnitId String?   @map("geographic_unit_id") @db.Uuid
  pollingStationId String?   @map("polling_station_id") @db.Uuid
  electionCycleId  String?   @map("election_cycle_id") @db.Uuid
  validFrom        DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  grantedById      String?   @map("granted_by_id") @db.Uuid
  reason           String?
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User            @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit? @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  pollingStation PollingStation? @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  electionCycle  ElectionCycle?  @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  grantedBy      User?           @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy      User?           @relation("AssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("role_assignments")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh-token secret (rotated on every refresh).
  refreshTokenHash String    @map("refresh_token_hash")
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  reauthAt         DateTime? @map("reauth_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}

model MfaFactor {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            MfaFactorType   @default(TOTP)
  status          MfaFactorStatus @default(PENDING)
  label           String?
  /// AES-256-GCM encrypted TOTP secret (iv:tag:ciphertext, base64).
  secretEncrypted String          @map("secret_encrypted")
  /// Last accepted TOTP time-step (replay protection).
  lastUsedStep    BigInt?         @map("last_used_step")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@map("mfa_factors")
}

/// Append-only audit stream. UPDATE/DELETE are blocked by trigger and privilege.
model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  seq        BigInt         @default(autoincrement())
  tenantId   String         @map("tenant_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @default(USER) @map("actor_type")
  action     String
  entityType String         @map("entity_type")
  entityId   String?        @map("entity_id")
  beforeHash String?        @map("before_hash")
  afterHash  String?        @map("after_hash")
  /// Redacted snapshot (secrets removed) for the S29 before/after view.
  before     Json?
  after      Json?
  reason     String?
  sourceIp   String?        @map("source_ip")
  userAgent  String?        @map("user_agent")
  requestId  String?        @map("request_id")
  /// SHA-256 over the canonical event content (tamper evidence).
  eventHash  String         @map("event_hash")
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([seq])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId])
  @@index([tenantId, action])
  @@map("audit_events")
}

/// Per-tenant human-readable reference counters (e.g. SUB-2027-000123).
model ReferenceSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  nextValue Int    @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, name])
  @@map("reference_sequences")
}

