/// Tenant-scoped role. System roles (is_system) are seeded from packages/shared SYSTEM_ROLES.
model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  name         String
  description  String   @default("")
  restrictions String?
  isSystem     Boolean  @default(false) @map("is_system")
  mfaRequired  Boolean  @default(false) @map("mfa_required")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// Global permission catalogue (not tenant-owned). Synced from packages/shared PERMISSION_DEFINITIONS.
model Permission {
  key         String  @id
  module      String
  action      String
  description String
  highRisk    Boolean @default(false) @map("high_risk")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

/// A grant of a role to a user, optionally limited by geography, election cycle and time.
model RoleAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  scopeType          ScopeType @default(ORGANISATION) @map("scope_type")
  geographicUnitId   String?   @map("geographic_unit_id") @db.Uuid
  pollingStationId   String?   @map("polling_station_id") @db.Uuid
  /// Station lineage key of a POLLING_STATION grant (filled from polling_station_id by a trigger).
  /// Grants match every registry version of the station's cycle by this code.
  pollingStationCode String?   @map("polling_station_code")
  electionCycleId    String?   @map("election_cycle_id") @db.Uuid
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(3)
  grantedById        String?   @map("granted_by_id") @db.Uuid
  reason             String?
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById        String?   @map("revoked_by_id") @db.Uuid
  revokedReason      String?   @map("revoked_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User            @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit? @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  pollingStation PollingStation? @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  electionCycle  ElectionCycle?  @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  grantedBy      User?           @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy      User?           @relation("AssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([tenantId, pollingStationCode])
  @@map("role_assignments")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh-token secret (rotated on every refresh).
  refreshTokenHash String    @map("refresh_token_hash")
  mfaVerifiedAt    DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  reauthAt         DateTime? @map("reauth_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}

model MfaFactor {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            MfaFactorType   @default(TOTP)
  status          MfaFactorStatus @default(PENDING)
  label           String?
  /// AES-256-GCM encrypted TOTP secret (iv:tag:ciphertext, base64).
  secretEncrypted String          @map("secret_encrypted")
  /// Last accepted TOTP time-step (replay protection).
  lastUsedStep    BigInt?         @map("last_used_step")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@map("mfa_factors")
}

/// Append-only audit stream. UPDATE/DELETE are blocked by trigger and privilege.
model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  seq        BigInt         @default(autoincrement())
  tenantId   String         @map("tenant_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @default(USER) @map("actor_type")
  action     String
  entityType String         @map("entity_type")
  entityId   String?        @map("entity_id")
  beforeHash String?        @map("before_hash")
  afterHash  String?        @map("after_hash")
  /// Redacted snapshot (secrets removed) for the S29 before/after view.
  before     Json?
  after      Json?
  reason     String?
  sourceIp   String?        @map("source_ip")
  userAgent  String?        @map("user_agent")
  requestId  String?        @map("request_id")
  /// SHA-256 over the canonical event content (tamper evidence).
  eventHash  String         @map("event_hash")
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([seq])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId])
  @@index([tenantId, action])
  @@map("audit_events")
}

/// Per-tenant human-readable reference counters (e.g. SUB-2027-000123).
model ReferenceSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  nextValue Int    @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, name])
  @@map("reference_sequences")
}

// ============================================================================
// Reference data
// ============================================================================

model ElectionCycle {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String
  electionDate       DateTime            @map("election_date") @db.Date
  jurisdiction       String              @default("Kenya")
  legalConfigVersion String              @map("legal_config_version")
  status             ElectionCycleStatus @default(DRAFT)
  dataProvenance     DataProvenance      @default(LIVE) @map("data_provenance")
  officialSources    Json                @default("[]") @map("official_sources")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  geographicUnits  GeographicUnit[]
  registryVersions RegistryVersion[]
  pollingStations  PollingStation[]
  tallyCentres     TallyCentre[]
  contests         Contest[]
  formTemplates    FormTemplate[]
  submissions      ResultSubmission[]
  discrepancyCases DiscrepancyCase[]
  snapshots        TallySnapshot[]
  roleAssignments  RoleAssignment[]

  agentAccreditations  AgentAccreditation[]
  agentTrainings       AgentTraining[]
  deployments          Deployment[]
  readinessChecklists  ReadinessChecklist[]
  fieldReportTemplates FieldReportTemplate[]
  fieldReports         FieldReport[]
  incidents            Incident[]
  stationStatuses      StationStatus[]

  // Campaign finance (limit settings and entries per election period)
  financeBudgetLines   FinanceBudgetLine[]   @relation("BudgetLineCycle")
  financeTransactions  FinanceTransaction[]  @relation("FinanceTransactionCycle")
  financeLimitSettings FinanceLimitSetting[] @relation("LimitSettingCycle")

  @@unique([tenantId, name])
  @@map("election_cycles")
}

model RegistryVersion {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  electionCycleId String                @map("election_cycle_id") @db.Uuid
  version         String
  source          String
  status          RegistryVersionStatus @default(DRAFT)
  stationCount    Int                   @default(0) @map("station_count")
  sourceFileId    String?               @map("source_file_id") @db.Uuid
  notes           String?
  publicationDate DateTime?             @map("publication_date") @db.Date
  importedAt      DateTime              @default(now()) @map("imported_at") @db.Timestamptz(3)
  approvedById    String?               @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle      @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  sourceFile      StoredFile?        @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  approvedBy      User?              @relation("RegistryApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  geographicUnits GeographicUnit[]
  pollingStations PollingStation[]
  submissions     ResultSubmission[]
  snapshots       TallySnapshot[]
  imports         RegistryImport[]

  @@unique([tenantId, electionCycleId, version])
  @@index([tenantId, electionCycleId, status])
  @@map("registry_versions")
}

/// Append-only log of registry import lifecycle events (QUEUED, RUNNING, COMPLETED, FAILED)
/// with the full validation report (blueprint 6.2). Updates and deletes are rejected by trigger.
model RegistryImport {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  registryVersionId String    @map("registry_version_id") @db.Uuid
  sourceFileId      String?   @map("source_file_id") @db.Uuid
  status            String
  publicationDate   DateTime? @map("publication_date") @db.Date
  sourceUrl         String?   @map("source_url")
  changeNotes       String?   @map("change_notes")
  report            Json?
  unitsCreated      Int       @default(0) @map("units_created")
  stationsCreated   Int       @default(0) @map("stations_created")
  rowsRejected      Int       @default(0) @map("rows_rejected")
  error             String?
  importedById      String    @map("imported_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registryVersion RegistryVersion @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  sourceFile      StoredFile?     @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  importedBy      User            @relation("RegistryImporter", fields: [importedById], references: [id], onDelete: Restrict)

  @@index([tenantId, registryVersionId, createdAt])
  @@map("registry_imports")
}

model GeographicUnit {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  electionCycleId   String             @map("election_cycle_id") @db.Uuid
  registryVersionId String?            @map("registry_version_id") @db.Uuid
  type              GeographicUnitType
  parentId          String?            @map("parent_id") @db.Uuid
  officialCode      String             @map("official_code")
  officialName      String             @map("official_name")
  /// Materialised path of ancestor ids including self: "/<county>/<constituency>/<ward>/".
  path              String
  sourceVersion     String             @map("source_version")
  validFrom         DateTime?          @map("valid_from") @db.Date
  validTo           DateTime?          @map("valid_to") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle    @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  registryVersion RegistryVersion? @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  parent          GeographicUnit?  @relation("GeoHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        GeographicUnit[] @relation("GeoHierarchy")

  stationsDirect         PollingStation[]   @relation("StationUnit")
  stationsInCounty       PollingStation[]   @relation("StationCounty")
  stationsInConstituency PollingStation[]   @relation("StationConstituency")
  stationsInWard         PollingStation[]   @relation("StationWard")
  stationsInCentre       PollingStation[]   @relation("StationCentre")
  tallyCentres           TallyCentre[]
  contests               Contest[]
  roleAssignments        RoleAssignment[]
  submissions            ResultSubmission[]
  snapshots              TallySnapshot[]

  // NGAO360 Office locations (down to ward level)
  casesAtUnit            CitizenCase[] @relation("CaseUnit")
  casesInCounty          CitizenCase[] @relation("CaseCounty")
  casesInConstituency    CitizenCase[] @relation("CaseConstituency")
  casesInWard            CitizenCase[] @relation("CaseWard")
  projectsAtUnit         Project[]     @relation("ProjectUnit")
  projectsInCounty       Project[]     @relation("ProjectCounty")
  projectsInConstituency Project[]     @relation("ProjectConstituency")
  projectsInWard         Project[]     @relation("ProjectWard")

  // Field and election operations (lowest unit of area-level records; agent home ward)
  agentsHomeWard Agent[]       @relation("AgentHomeWard")
  fieldReports   FieldReport[] @relation("FieldReportUnit")
  incidents      Incident[]    @relation("IncidentUnit")

  // Campaign and organisation (team area, task and event geography)
  teams          Team[]          @relation("TeamGeography")
  tasks          Task[]          @relation("TaskGeography")
  campaignEvents CampaignEvent[] @relation("EventGeography")

  @@unique([tenantId, electionCycleId, type, officialCode, sourceVersion])
  @@index([tenantId, electionCycleId, type])
  @@index([tenantId, parentId])
  @@index([tenantId, path])
  @@map("geographic_units")
}

model PollingStation {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  electionCycleId   String               @map("election_cycle_id") @db.Uuid
  registryVersionId String               @map("registry_version_id") @db.Uuid
  /// Lowest unit the station belongs to (polling centre, or ward when centres are not used).
  geographicUnitId  String               @map("geographic_unit_id") @db.Uuid
  countyId          String               @map("county_id") @db.Uuid
  constituencyId    String               @map("constituency_id") @db.Uuid
  wardId            String               @map("ward_id") @db.Uuid
  pollingCentreId   String?              @map("polling_centre_id") @db.Uuid
  code              String
  name              String
  streamNumber      Int?                 @map("stream_number")
  registeredVoters  Int?                 @map("registered_voters")
  status            PollingStationStatus @default(ACTIVE)
  latitude          Decimal?             @db.Decimal(9, 6)
  longitude         Decimal?             @db.Decimal(9, 6)
  locationSource    String?              @map("location_source")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle   @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  registryVersion RegistryVersion @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  geographicUnit  GeographicUnit  @relation("StationUnit", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  county          GeographicUnit  @relation("StationCounty", fields: [countyId], references: [id], onDelete: Restrict)
  constituency    GeographicUnit  @relation("StationConstituency", fields: [constituencyId], references: [id], onDelete: Restrict)
  ward            GeographicUnit  @relation("StationWard", fields: [wardId], references: [id], onDelete: Restrict)
  pollingCentre   GeographicUnit? @relation("StationCentre", fields: [pollingCentreId], references: [id], onDelete: Restrict)

  roleAssignments RoleAssignment[]
  submissions     ResultSubmission[]

  @@unique([tenantId, registryVersionId, code])
  @@index([tenantId, electionCycleId, code])
  @@index([tenantId, electionCycleId, countyId])
  @@index([tenantId, electionCycleId, constituencyId])
  @@index([tenantId, electionCycleId, wardId])
  /// War Room / readiness roll-ups scan the approved registry by version and status (field ops at 55k stations).
  @@index([tenantId, registryVersionId, status])
  @@map("polling_stations")
}

model TallyCentre {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  electionCycleId  String           @map("election_cycle_id") @db.Uuid
  level            TallyCentreLevel
  geographicUnitId String?          @map("geographic_unit_id") @db.Uuid
  code             String
  name             String
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle  ElectionCycle      @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit?    @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  submissions    ResultSubmission[]

  @@unique([tenantId, electionCycleId, code])
  @@map("tally_centres")
}

model Contest {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  electionCycleId  String        @map("election_cycle_id") @db.Uuid
  officeType       OfficeType    @map("office_type")
  name             String
  /// Electoral area of the contest (county for governor; null for president).
  geographicUnitId String?       @map("geographic_unit_id") @db.Uuid
  formSeries       String        @map("form_series")
  status           ContestStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle    ElectionCycle        @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  geographicUnit   GeographicUnit?      @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  candidates       CandidateReference[]
  submissions      ResultSubmission[]
  discrepancyCases DiscrepancyCase[]
  snapshots        TallySnapshot[]

  @@unique([tenantId, electionCycleId, officeType, geographicUnitId])
  @@index([tenantId, electionCycleId])
  @@map("contests")
}

/// Candidate exactly as printed on the approved form / official publication. No personal data beyond that.
model CandidateReference {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  contestId                String   @map("contest_id") @db.Uuid
  candidateNameAsPublished String   @map("candidate_name_as_published")
  partyLabel               String?  @map("party_label")
  isIndependent            Boolean  @default(false) @map("is_independent")
  ballotOrder              Int      @map("ballot_order")
  referenceCode            String?  @map("reference_code")
  source                   String
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contest      Contest       @relation(fields: [contestId], references: [id], onDelete: Restrict)
  resultValues ResultValue[]

  @@unique([tenantId, contestId, ballotOrder])
  @@map("candidate_references")
}

/// Versioned form-template registry (blueprint 8.1, 17.2). Approved templates are never edited.
model FormTemplate {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  electionCycleId   String                    @map("election_cycle_id") @db.Uuid
  contestType       OfficeType                @map("contest_type")
  formNumber        String                    @map("form_number")
  formLevel         FormLevel                 @map("form_level")
  version           Int
  title             String
  effectiveDate     DateTime                  @map("effective_date") @db.Date
  fieldSchema       Json                      @map("field_schema")
  validationRules   Json                      @map("validation_rules")
  officialSource    String                    @map("official_source")
  officialSourceUrl String?                   @map("official_source_url")
  approvalState     FormTemplateApprovalState @default(DRAFT) @map("approval_state")
  approvedById      String?                   @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?                 @map("approved_at") @db.Timestamptz(3)
  createdById       String?                   @map("created_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle      @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  approvedBy    User?              @relation("TemplateApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy     User?              @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions   ResultSubmission[]

  @@unique([tenantId, electionCycleId, formNumber, version])
  @@index([tenantId, electionCycleId, contestType, approvalState])
  @@map("form_templates")
}

// ============================================================================
// Files
// ============================================================================

/// Immutable original file. Content-addressed by SHA-256; one row per hash per tenant.
/// Only malware_scan_status / scanned_at may change after insert (enforced by trigger).
model StoredFile {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  sha256            String            @db.Char(64)
  mimeType          String            @map("mime_type")
  sizeBytes         BigInt            @map("size_bytes")
  originalFilename  String            @map("original_filename")
  purpose           StoredFilePurpose
  storageDriver     StorageDriverKind @map("storage_driver")
  storageKey        String            @map("storage_key")
  pageCount         Int?              @map("page_count")
  malwareScanStatus MalwareScanStatus @default(PENDING) @map("malware_scan_status")
  scannedAt         DateTime?         @map("scanned_at") @db.Timestamptz(3)
  uploadedById      String            @map("uploaded_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy       User               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  submissions      ResultSubmission[]
  registryVersions RegistryVersion[]
  registryImports  RegistryImport[]
  exports          TallyExport[]

  correspondenceAttachments CorrespondenceAttachment[]
  caseEvents                CaseEvent[]
  projectEvidence           ProjectEvidence[]

  agentAccreditations AgentAccreditation[]
  fieldReportEvidence FieldReportEvidence[]
  incidentEvidence    IncidentEvidence[]
  fieldFileClaims     FieldFileClaim[]

  taskAttachments  TaskAttachment[]
  eventDocuments   EventDocument[]
  financeDocuments FinanceTransactionDocument[]
  reportExports    ReportExport[]
  breachEvents     BreachEvent[]

  @@unique([tenantId, sha256])
  @@map("stored_files")
}

// ============================================================================
// NGAO TALLY
// ============================================================================

model ResultSubmission {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  /// Human-readable unique reference, e.g. SUB-2027-000123.
  reference         String
  electionCycleId   String               @map("election_cycle_id") @db.Uuid
  contestId         String               @map("contest_id") @db.Uuid
  formTemplateId    String               @map("form_template_id") @db.Uuid
  /// Denormalised from the template for the canonical-uniqueness index.
  formNumber        String               @map("form_number")
  pollingStationId  String?              @map("polling_station_id") @db.Uuid
  tallyCentreId     String?              @map("tally_centre_id") @db.Uuid
  /// Geographic unit of the record (station's lowest unit, or the tally centre's unit).
  geographicUnitId  String?              @map("geographic_unit_id") @db.Uuid
  registryVersionId String?              @map("registry_version_id") @db.Uuid
  submitterId       String               @map("submitter_id") @db.Uuid
  sourceFileId      String               @map("source_file_id") @db.Uuid
  sourceType        SubmissionSourceType @map("source_type")
  status            SubmissionStatus     @default(DRAFT)
  isCanonical       Boolean              @default(true) @map("is_canonical")
  duplicateFlag     Boolean              @default(false) @map("duplicate_flag")
  duplicateOfId     String?              @map("duplicate_of_id") @db.Uuid
  /// Original submitted metadata + declaration details (serial, observed stamp/signature, notes).
  declaration       Json                 @default("{}")
  originalMetadata  Json                 @default("{}") @map("original_metadata")
  imageQuality      ImageQuality?        @map("image_quality")
  pageCount         Int?                 @map("page_count")
  idempotencyKey    String               @map("idempotency_key") @db.Uuid
  /// Optimistic-concurrency version, incremented on every status change.
  version           Int                  @default(1)
  submittedAt       DateTime?            @map("submitted_at") @db.Timestamptz(3)
  verifiedAt        DateTime?            @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle      @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  contest         Contest            @relation(fields: [contestId], references: [id], onDelete: Restrict)
  formTemplate    FormTemplate       @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  pollingStation  PollingStation?    @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  tallyCentre     TallyCentre?       @relation(fields: [tallyCentreId], references: [id], onDelete: Restrict)
  geographicUnit  GeographicUnit?    @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  registryVersion RegistryVersion?   @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  submitter       User               @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  sourceFile      StoredFile         @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  duplicateOf     ResultSubmission?  @relation("SubmissionDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates      ResultSubmission[] @relation("SubmissionDuplicate")

  values            ResultValue[]
  valueChanges      ResultValueChange[]
  ocrExtractions    OcrExtraction[]
  validationResults ValidationResult[]
  verifications     Verification[]
  discrepancyLinks  DiscrepancyCaseSubmission[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, electionCycleId, contestId, status])
  @@index([tenantId, pollingStationId])
  @@index([tenantId, submitterId])
  @@index([tenantId, sourceFileId])
  @@index([tenantId, status, updatedAt(sort: Desc)])
  // Partial unique indexes for "one active canonical submission per station/centre + form + contest"
  // are defined in SQL (migration rls_and_integrity) because Prisma cannot express them.
  @@map("result_submissions")
}

/// Current value of one captured field. Every change is appended to result_value_changes.
model ResultValue {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  submissionId         String    @map("submission_id") @db.Uuid
  fieldKey             String    @map("field_key")
  candidateReferenceId String?   @map("candidate_reference_id") @db.Uuid
  numericValue         Int?      @map("numeric_value")
  textValue            String?   @map("text_value")
  ocrValue             String?   @map("ocr_value")
  ocrConfidence        Decimal?  @map("ocr_confidence") @db.Decimal(5, 4)
  confirmedById        String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz(3)
  changeVersion        Int       @default(0) @map("change_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission         ResultSubmission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  candidateReference CandidateReference? @relation(fields: [candidateReferenceId], references: [id], onDelete: Restrict)
  confirmedBy        User?               @relation("ValueConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  changes            ResultValueChange[]

  // Uniqueness of (submission, field_key, candidate) incl. NULL candidate is enforced by a SQL index.
  @@index([tenantId, submissionId])
  @@map("result_values")
}

/// Append-only change history: actor, old value, new value, time, reason (blueprint 17.2).
model ResultValueChange {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  resultValueId   String                  @map("result_value_id") @db.Uuid
  submissionId    String                  @map("submission_id") @db.Uuid
  fieldKey        String                  @map("field_key")
  changeVersion   Int                     @map("change_version")
  oldNumericValue Int?                    @map("old_numeric_value")
  newNumericValue Int?                    @map("new_numeric_value")
  oldTextValue    String?                 @map("old_text_value")
  newTextValue    String?                 @map("new_text_value")
  source          ResultValueChangeSource
  actorId         String                  @map("actor_id") @db.Uuid
  reason          String
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resultValue ResultValue      @relation(fields: [resultValueId], references: [id], onDelete: Restrict)
  submission  ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  actor       User             @relation("ValueChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([resultValueId, changeVersion])
  @@index([tenantId, submissionId])
  @@map("result_value_changes")
}

/// OCR draft extraction job record. Output is never an approved result.
model OcrExtraction {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  submissionId  String              @map("submission_id") @db.Uuid
  status        OcrExtractionStatus @default(QUEUED)
  engine        String?
  engineVersion String?             @map("engine_version")
  resultJson    Json?               @map("result_json")
  error         String?
  queuedAt      DateTime            @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([tenantId, submissionId])
  @@map("ocr_extractions")
}

/// One row per rule evaluated in a validation run.
model ValidationResult {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  submissionId String            @map("submission_id") @db.Uuid
  runId        String            @map("run_id") @db.Uuid
  rulesVersion Int               @map("rules_version")
  ruleKey      String            @map("rule_key")
  ruleVersion  Int               @map("rule_version")
  outcome      ValidationOutcome
  fieldKeys    String[]          @map("field_keys")
  message      String
  details      Json              @default("{}")
  reference    String
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([tenantId, submissionId, runId])
  @@map("validation_results")
}

/// Independent second-person review (blueprint 8.5).
model Verification {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  submissionId        String               @map("submission_id") @db.Uuid
  round               Int                  @default(1)
  reviewerId          String               @map("reviewer_id") @db.Uuid
  decision            VerificationDecision
  checklist           Json
  independentValues   Json                 @default("[]") @map("independent_values")
  mismatchedFieldKeys String[]             @map("mismatched_field_keys")
  fieldComments       Json                 @default("[]") @map("field_comments")
  notes               String?
  reviewedAt          DateTime             @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  supervisorAction    SupervisorAction?    @map("supervisor_action")
  supervisorId        String?              @map("supervisor_id") @db.Uuid
  supervisorReason    String?              @map("supervisor_reason")
  supervisorActionAt  DateTime?            @map("supervisor_action_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer   User             @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  supervisor User?            @relation("VerificationSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@unique([submissionId, round, reviewerId])
  @@index([tenantId, submissionId])
  @@index([tenantId, reviewerId])
  @@map("verifications")
}

model DiscrepancyCase {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  reference         String
  electionCycleId   String              @map("election_cycle_id") @db.Uuid
  contestId         String?             @map("contest_id") @db.Uuid
  varianceType      DiscrepancyType     @map("variance_type")
  severity          DiscrepancySeverity @default(MEDIUM)
  status            DiscrepancyStatus   @default(OPEN)
  title             String
  description       String
  details           Json                @default("{}")
  assignedToId      String?             @map("assigned_to_id") @db.Uuid
  openedById        String              @map("opened_by_id") @db.Uuid
  resolution        String?
  resolvedById      String?             @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz(3)
  closureApproverId String?             @map("closure_approver_id") @db.Uuid
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle               @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  contest         Contest?                    @relation(fields: [contestId], references: [id], onDelete: Restrict)
  assignedTo      User?                       @relation("DiscrepancyAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  openedBy        User                        @relation("DiscrepancyOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy      User?                       @relation("DiscrepancyResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  closureApprover User?                       @relation("DiscrepancyClosureApprover", fields: [closureApproverId], references: [id], onDelete: Restrict)
  links           DiscrepancyCaseSubmission[]
  actions         DiscrepancyCaseAction[]

  @@unique([tenantId, reference])
  @@index([tenantId, status, varianceType])
  @@index([tenantId, assignedToId])
  @@map("discrepancy_cases")
}

model DiscrepancyCaseSubmission {
  tenantId     String              @map("tenant_id") @db.Uuid
  caseId       String              @map("case_id") @db.Uuid
  submissionId String              @map("submission_id") @db.Uuid
  role         DiscrepancyLinkRole @default(RELATED)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       DiscrepancyCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  submission ResultSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@id([caseId, submissionId])
  @@index([tenantId, submissionId])
  @@map("discrepancy_case_submissions")
}

/// Append-only case activity log.
model DiscrepancyCaseAction {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  note      String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   DiscrepancyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor  User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId])
  @@map("discrepancy_case_actions")
}

/// Immutable aggregate snapshot (blueprint 8.6). Only released_at/released_by_id may be set, once.
model TallySnapshot {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  reference             String
  electionCycleId       String    @map("election_cycle_id") @db.Uuid
  contestId             String    @map("contest_id") @db.Uuid
  geographyScopeType    ScopeType @default(ORGANISATION) @map("geography_scope_type")
  geographicUnitId      String?   @map("geographic_unit_id") @db.Uuid
  calculationVersion    String    @map("calculation_version")
  includedSubmissionIds String[]  @map("included_submission_ids") @db.Uuid
  totalsJson            Json      @map("totals_json")
  coverageJson          Json      @map("coverage_json")
  expectedStations      Int       @map("expected_stations")
  includedStations      Int       @map("included_stations")
  registryVersionId     String?   @map("registry_version_id") @db.Uuid
  contentHash           String    @map("content_hash")
  note                  String?
  createdById           String    @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  releasedAt            DateTime? @map("released_at") @db.Timestamptz(3)
  releasedById          String?   @map("released_by_id") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle   ElectionCycle    @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  contest         Contest          @relation(fields: [contestId], references: [id], onDelete: Restrict)
  geographicUnit  GeographicUnit?  @relation(fields: [geographicUnitId], references: [id], onDelete: Restrict)
  registryVersion RegistryVersion? @relation(fields: [registryVersionId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("SnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy      User?            @relation("SnapshotReleaser", fields: [releasedById], references: [id], onDelete: Restrict)
  exports         TallyExport[]

  @@unique([tenantId, reference])
  @@index([tenantId, contestId, createdAt(sort: Desc)])
  @@map("tally_snapshots")
}

model TallyExport {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  snapshotId  String       @map("snapshot_id") @db.Uuid
  format      ExportFormat
  fileId      String       @map("file_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  snapshot  TallySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  file      StoredFile    @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, snapshotId])
  @@map("tally_exports")
}

// ============================================================================
// Operations (minimal in the foundation)
// ============================================================================

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  channel        NotificationChannel  @default(IN_APP)
  /// Permission module the notification belongs to; hidden if the user loses access.
  module         String
  type           String
  title          String
  body           String
  link           String?
  readAt         DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Notification centre (blueprint 10.3): severity, critical-alert acknowledgement, source record.
  severity       NotificationSeverity @default(INFO)
  requiresAck    Boolean              @default(false) @map("requires_ack")
  acknowledgedAt DateTime?            @map("acknowledged_at") @db.Timestamptz(3)
  entityType     String?              @map("entity_type")
  entityId       String?              @map("entity_id")

  tenant           Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       NotificationDelivery[]
  acknowledgements NotificationAcknowledgement[]

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ============================================================================
// Tenant module activation
// ============================================================================

/// Per-tenant module switch (packages/shared/src/modules.ts). A missing row means the
/// module's default applies. Switching a module off hides it; it never deletes data.
model TenantModule {
  tenantId    String   @map("tenant_id") @db.Uuid
  /// 'tally' | 'office' (CHECK constraint in the migration).
  moduleKey   String   @map("module_key")
  enabled     Boolean
  /// Module configuration, e.g. OfficeModuleConfig for 'office'.
  config      Json     @default("{}")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("ModuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([tenantId, moduleKey])
  @@map("tenant_modules")
}

// ============================================================================
// NGAO360 Office (blueprint 9). Separate tables and permissions from campaign
// and tally data (blueprint 15.2). Records are never deleted (DB triggers).
// ============================================================================

/// Registry of responsible bodies (county departments, national agencies, funds…).
model Institution {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  name            String
  shortName       String?         @map("short_name")
  type            InstitutionType
  parentId        String?         @map("parent_id") @db.Uuid
  contactEmail    String?         @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  physicalAddress String?         @map("physical_address")
  mandate         String?
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent         Institution?   @relation("InstitutionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Institution[]  @relation("InstitutionHierarchy")
  referrals      CaseReferral[]
  responsibleFor Project[]      @relation("ProjectResponsibleInstitution")
  implementing   Project[]      @relation("ProjectImplementingAgency")

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("institutions")
}

/// S23 correspondence register (incoming and outgoing).
model Correspondence {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  reference             String
  direction             CorrespondenceDirection
  channel               CorrespondenceChannel
  category              CorrespondenceCategory
  sensitivity           SensitivityLevel        @default(INTERNAL)
  subject               String
  senderName            String?                 @map("sender_name")
  senderOrganisation    String?                 @map("sender_organisation")
  recipientName         String?                 @map("recipient_name")
  recipientOrganisation String?                 @map("recipient_organisation")
  externalReference     String?                 @map("external_reference")
  documentDate          DateTime?               @map("document_date") @db.Date
  receivedAt            DateTime?               @map("received_at") @db.Timestamptz(3)
  sentAt                DateTime?               @map("sent_at") @db.Timestamptz(3)
  responseDueDate       DateTime?               @map("response_due_date") @db.Date
  status                CorrespondenceStatus
  assignedToId          String?                 @map("assigned_to_id") @db.Uuid
  summary               String?
  linkedCaseId          String?                 @map("linked_case_id") @db.Uuid
  inReplyToId           String?                 @map("in_reply_to_id") @db.Uuid
  createdById           String                  @map("created_by_id") @db.Uuid
  version               Int                     @default(0)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo   User?                      @relation("CorrespondenceAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User                       @relation("CorrespondenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  linkedCase   CitizenCase?               @relation(fields: [linkedCaseId], references: [id], onDelete: Restrict)
  inReplyTo    Correspondence?            @relation("CorrespondenceReplies", fields: [inReplyToId], references: [id], onDelete: Restrict)
  replies      Correspondence[]           @relation("CorrespondenceReplies")
  attachments  CorrespondenceAttachment[]
  appointments Appointment[]

  @@unique([tenantId, reference])
  @@index([tenantId, direction, status])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, responseDueDate])
  @@map("correspondence")
}

/// Scans and documents attached to correspondence. Append-only (never removed).
model CorrespondenceAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  correspondenceId String   @map("correspondence_id") @db.Uuid
  storedFileId     String   @map("stored_file_id") @db.Uuid
  label            String?
  addedById        String   @map("added_by_id") @db.Uuid
  addedAt          DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Restrict)
  storedFile     StoredFile     @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  addedBy        User           @relation("CorrespondenceAttachmentAdder", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([correspondenceId, storedFileId])
  @@index([tenantId, correspondenceId])
  @@map("correspondence_attachments")
}

/// Appointment requests and the office diary.
model Appointment {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  reference              String
  source                 AppointmentSource
  requesterName          String            @map("requester_name")
  requesterOrganisation  String?           @map("requester_organisation")
  contactPhone           String?           @map("contact_phone")
  contactEmail           String?           @map("contact_email")
  contactPreference      ContactPreference @default(PHONE) @map("contact_preference")
  purpose                String
  preferredStart         DateTime?         @map("preferred_start") @db.Timestamptz(3)
  preferredEnd           DateTime?         @map("preferred_end") @db.Timestamptz(3)
  confirmedStart         DateTime?         @map("confirmed_start") @db.Timestamptz(3)
  confirmedEnd           DateTime?         @map("confirmed_end") @db.Timestamptz(3)
  venue                  String?
  assignedOffice         String?           @map("assigned_office")
  assignedToId           String?           @map("assigned_to_id") @db.Uuid
  status                 AppointmentStatus @default(REQUESTED)
  outcome                String?
  outcomeRecordedAt      DateTime?         @map("outcome_recorded_at") @db.Timestamptz(3)
  followUpRequired       Boolean           @default(false) @map("follow_up_required")
  followUpDate           DateTime?         @map("follow_up_date") @db.Date
  followUpNotes          String?           @map("follow_up_notes")
  privacyNoticeVersion   String            @map("privacy_notice_version")
  linkedCaseId           String?           @map("linked_case_id") @db.Uuid
  linkedCorrespondenceId String?           @map("linked_correspondence_id") @db.Uuid
  createdById            String            @map("created_by_id") @db.Uuid
  version                Int               @default(0)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo           User?           @relation("AppointmentAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy            User            @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  linkedCase           CitizenCase?    @relation(fields: [linkedCaseId], references: [id], onDelete: Restrict)
  linkedCorrespondence Correspondence? @relation(fields: [linkedCorrespondenceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reference])
  @@index([tenantId, status, confirmedStart])
  @@index([tenantId, assignedToId])
  @@map("appointments")
}

/// Office meetings (kept lean: agenda and participants as JSON, minutes as text).
model Meeting {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  title               String
  scheduledStart      DateTime         @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd        DateTime?        @map("scheduled_end") @db.Timestamptz(3)
  venue               String?
  onlineLink          String?          @map("online_link")
  status              MeetingStatus    @default(SCHEDULED)
  sensitivity         SensitivityLevel @default(INTERNAL)
  /// MeetingAgendaItem[]
  agenda              Json             @default("[]")
  /// MeetingParticipant[]
  participants        Json             @default("[]")
  minutes             String?
  minutesRecordedById String?          @map("minutes_recorded_by_id") @db.Uuid
  minutesRecordedAt   DateTime?        @map("minutes_recorded_at") @db.Timestamptz(3)
  ownerId             String           @map("owner_id") @db.Uuid
  version             Int              @default(0)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner           User                @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  minutesRecorder User?               @relation("MeetingMinutesRecorder", fields: [minutesRecordedById], references: [id], onDelete: Restrict)
  actionItems     MeetingActionItem[]
  decisions       MeetingDecision[]

  @@index([tenantId, scheduledStart])
  @@map("meetings")
}

model MeetingActionItem {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  meetingId   String           @map("meeting_id") @db.Uuid
  description String
  ownerId     String?          @map("owner_id") @db.Uuid
  ownerName   String?          @map("owner_name")
  dueDate     DateTime?        @map("due_date") @db.Date
  status      ActionItemStatus @default(OPEN)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  owner   User?   @relation("MeetingActionOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId, meetingId])
  @@index([tenantId, ownerId, status])
  @@map("meeting_action_items")
}

/// Decision log. Append-only: a change is a new decision that supersedes the earlier one.
model MeetingDecision {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  meetingId    String   @map("meeting_id") @db.Uuid
  decision     String
  rationale    String?
  supersedesId String?  @map("supersedes_id") @db.Uuid
  recordedById String   @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meeting      Meeting           @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  supersedes   MeetingDecision?  @relation("DecisionSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy MeetingDecision[] @relation("DecisionSupersedes")
  recordedBy   User              @relation("MeetingDecisionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, meetingId])
  @@map("meeting_decisions")
}

/// S25 citizen case. Requester contact lives in citizen_case_contacts (separate
/// table, separate permission), never in this row.
model CitizenCase {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  /// Internal sequential reference, e.g. CASE-2026-000123.
  reference              String
  /// Random reference given to the requester, e.g. BGM-7K3F-9Q2X.
  publicReference        String             @map("public_reference")
  /// SHA-256 of the tracking code shown once to the requester (null for staff-recorded cases until issued).
  trackingCodeHash       String?            @map("tracking_code_hash")
  source                 CaseSource
  category               CaseCategory
  priority               CasePriority       @default(MEDIUM)
  sensitivity            SensitivityLevel   @default(INTERNAL)
  title                  String
  description            String
  /// Lowest unit given (ward, constituency or county); ancestors are denormalised below.
  geographicUnitId       String?            @map("geographic_unit_id") @db.Uuid
  countyId               String?            @map("county_id") @db.Uuid
  constituencyId         String?            @map("constituency_id") @db.Uuid
  wardId                 String?            @map("ward_id") @db.Uuid
  locationDescription    String?            @map("location_description")
  privacyNoticeVersion   String             @map("privacy_notice_version")
  consentToContact       Boolean            @default(false) @map("consent_to_contact")
  status                 CaseStatus         @default(SUBMITTED)
  assigneeId             String?            @map("assignee_id") @db.Uuid
  triagedById            String?            @map("triaged_by_id") @db.Uuid
  triagedAt              DateTime?          @map("triaged_at") @db.Timestamptz(3)
  nextReviewDate         DateTime?          @map("next_review_date") @db.Date
  resolutionSummary      String?            @map("resolution_summary")
  resolutionProposedById String?            @map("resolution_proposed_by_id") @db.Uuid
  resolutionProposedAt   DateTime?          @map("resolution_proposed_at") @db.Timestamptz(3)
  closureReason          CaseClosureReason? @map("closure_reason")
  closureNote            String?            @map("closure_note")
  closedById             String?            @map("closed_by_id") @db.Uuid
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz(3)
  duplicateOfId          String?            @map("duplicate_of_id") @db.Uuid
  /// Null for portal submissions.
  createdById            String?            @map("created_by_id") @db.Uuid
  submittedAt            DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  version                Int                @default(0)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when personal content (description, location text, requester messages and photos) was redacted.
  /// Only the SECURITY DEFINER function ngao_redact_citizen_case may set it; it is never cleared.
  redactedAt             DateTime?          @map("redacted_at") @db.Timestamptz(3)
  redactedById           String?            @map("redacted_by_id") @db.Uuid
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  geographicUnit       GeographicUnit?     @relation("CaseUnit", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  county               GeographicUnit?     @relation("CaseCounty", fields: [countyId], references: [id], onDelete: Restrict)
  constituency         GeographicUnit?     @relation("CaseConstituency", fields: [constituencyId], references: [id], onDelete: Restrict)
  ward                 GeographicUnit?     @relation("CaseWard", fields: [wardId], references: [id], onDelete: Restrict)
  assignee             User?               @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  triagedBy            User?               @relation("CaseTriager", fields: [triagedById], references: [id], onDelete: Restrict)
  resolutionProposedBy User?               @relation("CaseResolutionProposer", fields: [resolutionProposedById], references: [id], onDelete: Restrict)
  closedBy             User?               @relation("CaseCloser", fields: [closedById], references: [id], onDelete: Restrict)
  createdBy            User?               @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  duplicateOf          CitizenCase?        @relation("CaseDuplicates", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates           CitizenCase[]       @relation("CaseDuplicates")
  contact              CitizenCaseContact?
  events               CaseEvent[]
  referrals            CaseReferral[]
  correspondence       Correspondence[]
  appointments         Appointment[]

  @@unique([tenantId, reference])
  @@unique([tenantId, publicReference])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, countyId])
  @@index([tenantId, constituencyId])
  @@index([tenantId, wardId])
  @@index([tenantId, nextReviewDate])
  @@map("citizen_cases")
}

/// Optional requester contact, stored minimally and apart from the case body.
/// Read only through the contact endpoint (office.cases.contact.view, audited).
/// Erasure nulls the fields and sets erased_at; the row is never deleted.
model CitizenCaseContact {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  caseId            String            @unique @map("case_id") @db.Uuid
  name              String?
  phone             String?
  email             String?
  preference        ContactPreference @default(NONE)
  preferredLanguage String?           @map("preferred_language")
  retentionUntil    DateTime?         @map("retention_until") @db.Date
  erasedAt          DateTime?         @map("erased_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  citizenCase CitizenCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([tenantId, retentionUntil])
  @@map("citizen_case_contacts")
}

/// Case timeline. Append-only. PUBLIC events are shown to the requester on the
/// tracking page; INTERNAL events are staff-only.
model CaseEvent {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  caseId       String              @map("case_id") @db.Uuid
  type         CaseEventType
  visibility   CaseEventVisibility
  actorType    CaseEventActorType  @map("actor_type")
  actorId      String?             @map("actor_id") @db.Uuid
  body         String?
  fromStatus   CaseStatus?         @map("from_status")
  toStatus     CaseStatus?         @map("to_status")
  storedFileId String?             @map("stored_file_id") @db.Uuid
  referralId   String?             @map("referral_id") @db.Uuid
  /// Set when the requester-supplied body and photo link were removed by a redaction.
  redactedAt   DateTime?           @map("redacted_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  citizenCase CitizenCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor       User?         @relation("CaseEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  storedFile  StoredFile?   @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  referral    CaseReferral? @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, createdAt])
  @@map("case_events")
}

/// Referral of a case to the institution responsible. Never deleted.
model CaseReferral {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  caseId                 String         @map("case_id") @db.Uuid
  institutionId          String         @map("institution_id") @db.Uuid
  referredAt             DateTime       @map("referred_at") @db.Date
  contactPerson          String?        @map("contact_person")
  contactDetail          String?        @map("contact_detail")
  institutionReference   String?        @map("institution_reference")
  followUpDate           DateTime?      @map("follow_up_date") @db.Date
  status                 ReferralStatus @default(SENT)
  responseSummary        String?        @map("response_summary")
  requesterContactShared Boolean        @default(false) @map("requester_contact_shared")
  referredById           String         @map("referred_by_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  citizenCase CitizenCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  referredBy  User        @relation("CaseReferrer", fields: [referredById], references: [id], onDelete: Restrict)
  events      CaseEvent[]

  @@index([tenantId, caseId])
  @@index([tenantId, followUpDate])
  @@map("case_referrals")
}

/// S26/S27 development project. Names the responsible institution; the office
/// tracks the project, it does not claim to control it.
model Project {
  id                            String             @id @default(uuid()) @db.Uuid
  tenantId                      String             @map("tenant_id") @db.Uuid
  reference                     String
  name                          String
  description                   String?
  category                      ProjectCategory
  geographicUnitId              String?            @map("geographic_unit_id") @db.Uuid
  countyId                      String?            @map("county_id") @db.Uuid
  constituencyId                String?            @map("constituency_id") @db.Uuid
  wardId                        String?            @map("ward_id") @db.Uuid
  locationDescription           String?            @map("location_description")
  latitude                      Decimal?           @db.Decimal(9, 6)
  longitude                     Decimal?           @db.Decimal(9, 6)
  responsibleInstitutionId      String             @map("responsible_institution_id") @db.Uuid
  implementingAgencyId          String?            @map("implementing_agency_id") @db.Uuid
  ownerName                     String?            @map("owner_name")
  trackingOfficerId             String?            @map("tracking_officer_id") @db.Uuid
  approvalAuthority             String?            @map("approval_authority")
  commitmentSource              CommitmentSource   @map("commitment_source")
  commitmentSourceDetail        String?            @map("commitment_source_detail")
  fundingSource                 FundingSource      @default(NOT_YET_IDENTIFIED) @map("funding_source")
  fundingSourceDetail           String?            @map("funding_source_detail")
  currency                      String             @default("KES") @db.Char(3)
  approvedAllocation            Decimal?           @map("approved_allocation") @db.Decimal(16, 2)
  allocationSource              String?            @map("allocation_source")
  contractAmount                Decimal?           @map("contract_amount") @db.Decimal(16, 2)
  contractAmountIsPublic        Boolean            @default(false) @map("contract_amount_is_public")
  expenditureReported           Decimal?           @map("expenditure_reported") @db.Decimal(16, 2)
  expenditureSource             String?            @map("expenditure_source")
  expenditureAsOf               DateTime?          @map("expenditure_as_of") @db.Date
  expenditureVerificationStatus VerificationStatus @default(UNVERIFIED) @map("expenditure_verification_status")
  expenditureVerifiedById       String?            @map("expenditure_verified_by_id") @db.Uuid
  expenditureVerifiedAt         DateTime?          @map("expenditure_verified_at") @db.Timestamptz(3)
  startDate                     DateTime?          @map("start_date") @db.Date
  expectedCompletionDate        DateTime?          @map("expected_completion_date") @db.Date
  actualCompletionDate          DateTime?          @map("actual_completion_date") @db.Date
  delayReason                   String?            @map("delay_reason")
  status                        ProjectStatus      @default(PROPOSED)
  completionReportedById        String?            @map("completion_reported_by_id") @db.Uuid
  completionReportedAt          DateTime?          @map("completion_reported_at") @db.Timestamptz(3)
  completionVerifiedById        String?            @map("completion_verified_by_id") @db.Uuid
  completionVerifiedAt          DateTime?          @map("completion_verified_at") @db.Timestamptz(3)
  completionVerificationNote    String?            @map("completion_verification_note")
  /// Evidence cited by the completion verification (re-checked when one of them is disputed).
  completionEvidenceIds         String[]           @default([]) @map("completion_evidence_ids") @db.Uuid
  isPublic                      Boolean            @default(false) @map("is_public")
  /// Approved optional public fields (PROJECT_PUBLIC_FIELD_KEYS).
  publicFields                  String[]           @default([]) @map("public_fields")
  publicSummary                 String?            @map("public_summary")
  publishedById                 String?            @map("published_by_id") @db.Uuid
  publishedAt                   DateTime?          @map("published_at") @db.Timestamptz(3)
  createdById                   String             @map("created_by_id") @db.Uuid
  version                       Int                @default(0)
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  geographicUnit         GeographicUnit?    @relation("ProjectUnit", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  county                 GeographicUnit?    @relation("ProjectCounty", fields: [countyId], references: [id], onDelete: Restrict)
  constituency           GeographicUnit?    @relation("ProjectConstituency", fields: [constituencyId], references: [id], onDelete: Restrict)
  ward                   GeographicUnit?    @relation("ProjectWard", fields: [wardId], references: [id], onDelete: Restrict)
  responsibleInstitution Institution        @relation("ProjectResponsibleInstitution", fields: [responsibleInstitutionId], references: [id], onDelete: Restrict)
  implementingAgency     Institution?       @relation("ProjectImplementingAgency", fields: [implementingAgencyId], references: [id], onDelete: Restrict)
  trackingOfficer        User?              @relation("ProjectTrackingOfficer", fields: [trackingOfficerId], references: [id], onDelete: Restrict)
  createdBy              User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  completionReportedBy   User?              @relation("ProjectCompletionReporter", fields: [completionReportedById], references: [id], onDelete: Restrict)
  completionVerifiedBy   User?              @relation("ProjectCompletionVerifier", fields: [completionVerifiedById], references: [id], onDelete: Restrict)
  expenditureVerifiedBy  User?              @relation("ProjectExpenditureVerifier", fields: [expenditureVerifiedById], references: [id], onDelete: Restrict)
  publishedBy            User?              @relation("ProjectPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  milestones             ProjectMilestone[]
  evidence               ProjectEvidence[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, countyId])
  @@index([tenantId, constituencyId])
  @@index([tenantId, wardId])
  @@index([tenantId, responsibleInstitutionId])
  @@index([tenantId, isPublic])
  @@map("projects")
}

model ProjectMilestone {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  projectId          String             @map("project_id") @db.Uuid
  sequence           Int
  title              String
  description        String?
  plannedDate        DateTime?          @map("planned_date") @db.Date
  actualDate         DateTime?          @map("actual_date") @db.Date
  status             MilestoneStatus    @default(PLANNED)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedById       String?            @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  verificationNote   String?            @map("verification_note")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  verifiedBy User?             @relation("MilestoneVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  evidence   ProjectEvidence[]

  @@unique([projectId, sequence])
  @@index([tenantId, projectId])
  @@map("project_milestones")
}

/// Evidence for a project or milestone. The file and upload facts are immutable
/// (trigger); only the verification and publication fields may change.
model ProjectEvidence {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  projectId          String              @map("project_id") @db.Uuid
  milestoneId        String?             @map("milestone_id") @db.Uuid
  type               ProjectEvidenceType
  description        String
  capturedOn         DateTime?           @map("captured_on") @db.Date
  sourceDescription  String?             @map("source_description")
  storedFileId       String              @map("stored_file_id") @db.Uuid
  uploadedById       String              @map("uploaded_by_id") @db.Uuid
  uploadedAt         DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  latitude           Decimal?            @db.Decimal(9, 6)
  longitude          Decimal?            @db.Decimal(9, 6)
  verificationStatus VerificationStatus  @default(UNVERIFIED) @map("verification_status")
  verifiedById       String?             @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?           @map("verified_at") @db.Timestamptz(3)
  verificationNote   String?             @map("verification_note")
  isPublic           Boolean             @default(false) @map("is_public")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone  ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  storedFile StoredFile        @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy User?             @relation("EvidenceVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId])
  @@index([tenantId, milestoneId])
  @@map("project_evidence")
}

