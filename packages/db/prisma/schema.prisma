// ---------------------------------------------------------------------------
// Events and logistics (blueprint 5.3, S09)
// ---------------------------------------------------------------------------

model CampaignEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  /// EVT-YYYY-NNNNNN
  reference          String
  title              String
  type               CampaignEventType
  purpose            String?
  startsAt           DateTime                @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime                @map("ends_at") @db.Timestamptz(3)
  venueName          String?                 @map("venue_name")
  venueAddress       String?                 @map("venue_address")
  /// Venue coordinates (a place, never a person).
  latitude           Decimal?                @db.Decimal(9, 6)
  longitude          Decimal?                @db.Decimal(9, 6)
  geographicUnitId   String?                 @map("geographic_unit_id") @db.Uuid
  organiserId        String                  @map("organiser_id") @db.Uuid
  departmentId       String?                 @map("department_id") @db.Uuid
  budgetMinor        BigInt?                 @map("budget_minor")
  currency           String                  @default("KES") @db.Char(3)
  visibility         CampaignEventVisibility @default(INTERNAL)
  status             CampaignEventStatus     @default(DRAFT)
  cancellationReason String?                 @map("cancellation_reason")
  createdById        String                  @map("created_by_id") @db.Uuid
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organiser           User                    @relation("EventOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)
  createdBy           User                    @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  department          Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  geographicUnit      GeographicUnit?         @relation("EventGeography", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  invitedTeams        EventInvitedTeam[]
  agendaItems         EventAgendaItem[]
  logisticsItems      EventLogisticsItem[]
  attendances         EventAttendance[]
  documents           EventDocument[]
  afterActionReport   EventAfterActionReport?
  contentItems        ContentItem[]
  budgetLines         FinanceBudgetLine[]
  financeTransactions FinanceTransaction[]

  @@unique([tenantId, reference])
  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@map("campaign_events")
}

model EventInvitedTeam {
  tenantId  String   @map("tenant_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event  CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team   Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([eventId, teamId])
  @@index([tenantId, teamId])
  @@map("event_invited_teams")
}

model EventAgendaItem {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  position        Int
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int?      @map("duration_minutes")
  title           String
  notes           String?
  ownerId         String?   @map("owner_id") @db.Uuid
  /// Removed from the agenda (kept as history).
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event  CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  owner  User?         @relation("AgendaOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId, eventId])
  @@map("event_agenda_items")
}

model EventLogisticsItem {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  itemType       LogisticsItemType @map("item_type")
  description    String
  assetReference String?           @map("asset_reference")
  /// Supplier name as text; finance payee records stay in finance.
  supplierName   String?           @map("supplier_name")
  quantity       Int               @default(1)
  custodianId    String?           @map("custodian_id") @db.Uuid
  collectionAt   DateTime?         @map("collection_at") @db.Timestamptz(3)
  returnDueAt    DateTime?         @map("return_due_at") @db.Timestamptz(3)
  returnedAt     DateTime?         @map("returned_at") @db.Timestamptz(3)
  status         LogisticsStatus   @default(REQUESTED)
  damageNotes    String?           @map("damage_notes")
  createdById    String            @map("created_by_id") @db.Uuid
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event     CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  custodian User?         @relation("LogisticsCustodian", fields: [custodianId], references: [id], onDelete: Restrict)
  createdBy User          @relation("LogisticsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, eventId])
  @@index([tenantId, custodianId])
  @@map("event_logistics_items")
}

model EventAttendance {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  eventId           String         @map("event_id") @db.Uuid
  participantName   String         @map("participant_name")
  participantUserId String?        @map("participant_user_id") @db.Uuid
  teamId            String?        @map("team_id") @db.Uuid
  role              AttendanceRole @default(PARTICIPANT)
  checkInMethod     CheckInMethod  @default(MANUAL) @map("check_in_method")
  checkedInAt       DateTime       @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  recordedById      String         @map("recorded_by_id") @db.Uuid
  hasContact        Boolean        @default(false) @map("has_contact")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event           CampaignEvent           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participantUser User?                   @relation("AttendanceUser", fields: [participantUserId], references: [id], onDelete: Restrict)
  team            Team?                   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  recordedBy      User                    @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  contact         EventAttendanceContact?

  @@index([tenantId, eventId])
  @@map("event_attendances")
}

/// Optional consent-based contact details, stored apart from attendance and read
/// only through the audited endpoint (events.attendance.contact). Erasure nulls the values.
model EventAttendanceContact {
  attendanceId         String    @id @map("attendance_id") @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  phone                String?
  email                String?
  consentNoticeVersion String    @map("consent_notice_version")
  purpose              String
  consentedAt          DateTime  @map("consented_at") @db.Timestamptz(3)
  erasedAt             DateTime? @map("erased_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attendance EventAttendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)

  @@map("event_attendance_contacts")
}

/// Append-only. Files use storage purpose EVENT_DOCUMENT.
model EventDocument {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  fileId    String            @map("file_id") @db.Uuid
  kind      EventDocumentKind
  note      String?
  addedById String            @map("added_by_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event   CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  file    StoredFile    @relation(fields: [fileId], references: [id], onDelete: Restrict)
  addedBy User          @relation("EventDocumentAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([tenantId, eventId])
  @@map("event_documents")
}

/// One per event. Approved reports are immutable; reviewer ≠ author (DB check).
model EventAfterActionReport {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  eventId             String            @unique @map("event_id") @db.Uuid
  status              AfterActionStatus @default(DRAFT)
  whatOccurred        String            @map("what_occurred")
  attendanceTotal     Int               @map("attendance_total")
  attendanceBreakdown Json              @default("{}") @map("attendance_breakdown")
  actualSpendMinor    BigInt?           @map("actual_spend_minor")
  currency            String            @default("KES") @db.Char(3)
  issues              String?
  lessons             String?
  authorId            String            @map("author_id") @db.Uuid
  reviewerId          String?           @map("reviewer_id") @db.Uuid
  reviewedAt          DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewNote          String?           @map("review_note")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event    CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  author   User          @relation("AfterActionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User?         @relation("AfterActionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("event_after_action_reports")
}

// ---------------------------------------------------------------------------
// Communications content workflow (blueprint 5.4)
// ---------------------------------------------------------------------------

/// Content item. Audience is a broad category, never a recipient list. Approver ≠ author (DB check);
/// published text changes only with a new revision (DB trigger).
model ContentItem {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  /// CNT-YYYY-NNNNNN
  reference       String
  type            ContentType
  title           String
  summary         String?
  body            String
  audience        ContentAudience
  departmentId    String?         @map("department_id") @db.Uuid
  eventId         String?         @map("event_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  editorId        String?         @map("editor_id") @db.Uuid
  approverId      String?         @map("approver_id") @db.Uuid
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(3)
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(3)
  publishedById   String?         @map("published_by_id") @db.Uuid
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  withdrawnAt     DateTime?       @map("withdrawn_at") @db.Timestamptz(3)
  scheduledFor    DateTime?       @map("scheduled_for") @db.Timestamptz(3)
  status          ContentStatus   @default(DRAFT)
  /// Body revision number (1 = first draft); bumped on every text change.
  revision        Int             @default(1)
  correctionCount Int             @default(0) @map("correction_count")
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event       CampaignEvent?    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  author      User              @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editor      User?             @relation("ContentEditor", fields: [editorId], references: [id], onDelete: Restrict)
  approver    User?             @relation("ContentApprover", fields: [approverId], references: [id], onDelete: Restrict)
  publishedBy User?             @relation("ContentPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  revisions   ContentRevision[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, authorId])
  @@map("content_items")
}

/// Append-only revision, workflow and correction history.
model ContentRevision {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  contentId  String              @map("content_id") @db.Uuid
  kind       ContentRevisionKind
  revision   Int
  title      String
  body       String
  bodySha256 String              @map("body_sha256") @db.Char(64)
  fromStatus ContentStatus?      @map("from_status")
  toStatus   ContentStatus?      @map("to_status")
  note       String?
  actorId    String              @map("actor_id") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Restrict)
  actor   User        @relation("ContentRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, contentId, createdAt])
  @@map("content_revisions")
}

// ---------------------------------------------------------------------------
// Finance (blueprint 5, 10.1, 14, 15.3). Integer minor units + currency only.
// ---------------------------------------------------------------------------

model FinanceAccount {
  id                         String               @id @default(uuid()) @db.Uuid
  tenantId                   String               @map("tenant_id") @db.Uuid
  name                       String
  type                       FinanceAccountType
  institution                String?
  /// "•••• 4821" — full account numbers are never stored.
  accountNumberMasked        String?              @map("account_number_masked")
  currency                   String               @default("KES") @db.Char(3)
  isDedicatedCampaignAccount Boolean              @default(false) @map("is_dedicated_campaign_account")
  status                     FinanceAccountStatus @default(ACTIVE)
  createdById                String               @map("created_by_id") @db.Uuid
  version                    Int                  @default(1)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("FinanceAccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions        FinanceTransaction[] @relation("TransactionAccount")
  counterTransactions FinanceTransaction[] @relation("TransactionCounterAccount")

  @@unique([tenantId, name])
  @@map("finance_accounts")
}

model FinanceCategory {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  code        String
  name        String
  kind        FinanceCategoryKind
  parentId    String?             @map("parent_id") @db.Uuid
  description String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent       FinanceCategory?     @relation("FinanceCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     FinanceCategory[]    @relation("FinanceCategoryTree")
  transactions FinanceTransaction[]
  budgetLines  FinanceBudgetLine[]

  @@unique([tenantId, code])
  @@map("finance_categories")
}

/// Supplier / payee. Tax PIN and phone stored masked; a keyed hash detects duplicates.
model FinancePayee {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  name         String
  kind         FinancePayeeKind
  taxPinMasked String?          @map("tax_pin_masked")
  taxPinHash   String?          @map("tax_pin_hash")
  phoneMasked  String?          @map("phone_masked")
  active       Boolean          @default(true)
  notes        String?
  createdById  String           @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("FinancePayeeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions FinanceTransaction[]

  @@unique([tenantId, taxPinHash])
  @@index([tenantId, name])
  @@map("finance_payees")
}

/// Contributor (contribution register). The identifier is stored masked plus a keyed hash.
model ContributionSource {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  displayName      String                 @map("display_name")
  kind             ContributionSourceKind
  identifierMasked String?                @map("identifier_masked")
  identifierHash   String?                @map("identifier_hash")
  declared         Boolean                @default(false)
  declaredAt       DateTime?              @map("declared_at") @db.Timestamptz(3)
  notes            String?
  createdById      String                 @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ContributionSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions FinanceTransaction[]

  @@unique([tenantId, identifierHash])
  @@index([tenantId, displayName])
  @@map("contribution_sources")
}

/// Budget line for a department or an event. Approver ≠ creator (DB check).
model FinanceBudgetLine {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  code            String
  name            String
  departmentId    String?          @map("department_id") @db.Uuid
  eventId         String?          @map("event_id") @db.Uuid
  categoryId      String?          @map("category_id") @db.Uuid
  electionCycleId String?          @map("election_cycle_id") @db.Uuid
  amountMinor     BigInt           @map("amount_minor")
  currency        String           @default("KES") @db.Char(3)
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  status          BudgetLineStatus @default(DRAFT)
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(3)
  createdById     String           @map("created_by_id") @db.Uuid
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department    Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event         CampaignEvent?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  category      FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle?       @relation("BudgetLineCycle", fields: [electionCycleId], references: [id], onDelete: Restrict)
  approvedBy    User?                @relation("BudgetLineApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("BudgetLineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions  FinanceTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@index([tenantId, eventId])
  @@map("finance_budget_lines")
}

/// Ledger entry. Requester ≠ approver and requester ≠ payer (DB checks); approver ≠ payer when
/// configured (service). Approval needs category, counterparty, reference and a document (DB
/// trigger). Financial fields are frozen from APPROVED on; corrections are REVERSAL entries.
model FinanceTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  /// FIN-YYYY-NNNNNN
  reference             String
  type                  FinanceTransactionType
  status                FinanceTransactionStatus @default(DRAFT)
  accountId             String                   @map("account_id") @db.Uuid
  counterAccountId      String?                  @map("counter_account_id") @db.Uuid
  categoryId            String                   @map("category_id") @db.Uuid
  budgetLineId          String?                  @map("budget_line_id") @db.Uuid
  amountMinor           BigInt                   @map("amount_minor")
  currency              String                   @default("KES") @db.Char(3)
  transactionDate       DateTime                 @map("transaction_date") @db.Date
  payeeId               String?                  @map("payee_id") @db.Uuid
  contributionSourceId  String?                  @map("contribution_source_id") @db.Uuid
  /// Receipt / invoice / bank or mobile-money reference.
  externalReference     String?                  @map("external_reference")
  description           String
  departmentId          String?                  @map("department_id") @db.Uuid
  eventId               String?                  @map("event_id") @db.Uuid
  electionCycleId       String?                  @map("election_cycle_id") @db.Uuid
  requestedById         String                   @map("requested_by_id") @db.Uuid
  requestedAt           DateTime?                @map("requested_at") @db.Timestamptz(3)
  approvedById          String?                  @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?                @map("approved_at") @db.Timestamptz(3)
  rejectedById          String?                  @map("rejected_by_id") @db.Uuid
  rejectedAt            DateTime?                @map("rejected_at") @db.Timestamptz(3)
  rejectionReason       String?                  @map("rejection_reason")
  paidById              String?                  @map("paid_by_id") @db.Uuid
  paidAt                DateTime?                @map("paid_at") @db.Timestamptz(3)
  paymentReference      String?                  @map("payment_reference")
  cancelledAt           DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?                  @map("cancellation_reason")
  /// For REVERSAL entries: the entry being reversed (each entry can be reversed once).
  reversesId            String?                  @unique @map("reverses_id") @db.Uuid
  reversedAt            DateTime?                @map("reversed_at") @db.Timestamptz(3)
  complianceFlags       String[]                 @default([]) @map("compliance_flags")
  complianceEvaluatedAt DateTime?                @map("compliance_evaluated_at") @db.Timestamptz(3)
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account            FinanceAccount               @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  counterAccount     FinanceAccount?              @relation("TransactionCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)
  category           FinanceCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetLine         FinanceBudgetLine?           @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  payee              FinancePayee?                @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  contributionSource ContributionSource?          @relation(fields: [contributionSourceId], references: [id], onDelete: Restrict)
  department         Department?                  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  event              CampaignEvent?               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  electionCycle      ElectionCycle?               @relation("FinanceTransactionCycle", fields: [electionCycleId], references: [id], onDelete: Restrict)
  requestedBy        User                         @relation("FinanceRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy         User?                        @relation("FinanceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy         User?                        @relation("FinanceRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  paidBy             User?                        @relation("FinancePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  reverses           FinanceTransaction?          @relation("TransactionReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy         FinanceTransaction?          @relation("TransactionReversal")
  documents          FinanceTransactionDocument[]
  events             FinanceTransactionEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, type, transactionDate])
  @@index([tenantId, accountId])
  @@index([tenantId, contributionSourceId])
  @@index([tenantId, budgetLineId])
  @@map("finance_transactions")
}

/// Append-only. Files use storage purpose FINANCE_DOCUMENT.
model FinanceTransactionDocument {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  transactionId String              @map("transaction_id") @db.Uuid
  fileId        String              @map("file_id") @db.Uuid
  kind          FinanceDocumentKind
  note          String?
  addedById     String              @map("added_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transaction FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  file        StoredFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  addedBy     User               @relation("FinanceDocumentAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([tenantId, transactionId])
  @@map("finance_transaction_documents")
}

/// Append-only.
model FinanceTransactionEvent {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String                      @map("tenant_id") @db.Uuid
  transactionId String                      @map("transaction_id") @db.Uuid
  type          FinanceTransactionEventType
  fromStatus    FinanceTransactionStatus?   @map("from_status")
  toStatus      FinanceTransactionStatus?   @map("to_status")
  actorId       String                      @map("actor_id") @db.Uuid
  note          String?
  data          Json?
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transaction FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  actor       User               @relation("FinanceEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, transactionId, createdAt])
  @@map("finance_transaction_events")
}

/// Tenant-configured finance limit (blueprint 15.3: never hardcoded). Versioned: value columns are
/// immutable (DB trigger); a change creates a new row that supersedes this one.
model FinanceLimitSetting {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  kind             FinanceLimitKind
  label            String
  /// SINGLE_SOURCE_CAP_PCT in basis points (2000 = 20 %).
  valueBasisPoints Int?             @map("value_basis_points")
  capBasis         FinanceCapBasis? @map("cap_basis")
  /// SPENDING_LIMIT in minor units.
  valueMinor       BigInt?          @map("value_minor")
  currency         String?          @db.Char(3)
  deadlineDate     DateTime?        @map("deadline_date") @db.Date
  electionCycleId  String?          @map("election_cycle_id") @db.Uuid
  periodLabel      String           @map("period_label")
  officeType       OfficeType?      @map("office_type")
  effectiveFrom    DateTime         @map("effective_from") @db.Date
  effectiveTo      DateTime?        @map("effective_to") @db.Date
  legalSourceNote  String           @map("legal_source_note")
  verified         Boolean          @default(false)
  verifiedById     String?          @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz(3)
  enforcement      LimitEnforcement @default(WARN)
  supersedesId     String?          @unique @map("supersedes_id") @db.Uuid
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle?       @relation("LimitSettingCycle", fields: [electionCycleId], references: [id], onDelete: Restrict)
  verifiedBy    User?                @relation("LimitSettingVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("LimitSettingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes    FinanceLimitSetting? @relation("LimitSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy  FinanceLimitSetting? @relation("LimitSupersedes")

  @@index([tenantId, kind, effectiveFrom])
  @@map("finance_limit_settings")
}

// ---------------------------------------------------------------------------
// Report builder (blueprint 10.2, S28)
// ---------------------------------------------------------------------------

/// Saved report template. Archived instead of deleted.
model ReportTemplate {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  name              String
  description       String?
  /// Key in REPORT_DATASETS (packages/shared/src/campaign/reports/datasets.ts).
  datasetKey        String              @map("dataset_key")
  /// ReportDefinition (validated against the registry on every save and run).
  definition        Json
  ownerId           String              @map("owner_id") @db.Uuid
  permissionScope   ReportTemplateScope @default(PRIVATE) @map("permission_scope")
  sharedRoleKeys    String[]            @default([]) @map("shared_role_keys")
  classification    SensitivityLevel    @default(INTERNAL)
  standardReportKey String?             @map("standard_report_key")
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner   User           @relation("ReportTemplateOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  exports ReportExport[]

  @@index([tenantId, ownerId])
  @@index([tenantId, datasetKey])
  @@map("report_templates")
}

/// Append-only export log (blueprint 10.2 steps 6–7).
model ReportExport {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  templateId         String?          @map("template_id") @db.Uuid
  datasetKey         String           @map("dataset_key")
  format             ExportFormat
  fields             String[]         @default([])
  definition         Json
  filtersDescription String           @map("filters_description")
  appliedScope       String           @map("applied_scope")
  classification     SensitivityLevel
  sensitive          Boolean          @default(false)
  rowCount           Int              @map("row_count")
  fileId             String?          @map("file_id") @db.Uuid
  sha256             String?          @db.Char(64)
  reason             String?
  /// Time of the re-authentication that allowed a sensitive export.
  reauthAt           DateTime?        @map("reauth_at") @db.Timestamptz(3)
  generatedById      String           @map("generated_by_id") @db.Uuid
  generatedAt        DateTime         @default(now()) @map("generated_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template    ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  file        StoredFile?     @relation(fields: [fileId], references: [id], onDelete: Restrict)
  generatedBy User            @relation("ReportExportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([tenantId, generatedAt])
  @@index([tenantId, generatedById])
  @@map("report_exports")
}

// ---------------------------------------------------------------------------
// Notification centre (blueprint 10.3). Extends `notifications`.
// ---------------------------------------------------------------------------

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  /// A notification type or '*' (channel default).
  type      String
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, channel, type])
  @@map("notification_preferences")
}

/// Append-only: one row per delivery attempt and channel (in-app rows are implicit).
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannel
  provider          String
  status            NotificationDeliveryStatus
  attempt           Int                        @default(1)
  error             String?
  providerMessageId String?                    @map("provider_message_id")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([tenantId, notificationId])
  @@index([tenantId, status, createdAt])
  @@map("notification_deliveries")
}

/// Append-only acknowledgement / escalation / closure record for critical alerts.
model NotificationAcknowledgement {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  notificationId String                @map("notification_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  action         NotificationAckAction
  note           String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  user         User         @relation("NotificationAckUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, notificationId])
  @@map("notification_acknowledgements")
}

// ---------------------------------------------------------------------------
// Data breach register (blueprint 15.4)
// ---------------------------------------------------------------------------

/// Breach or drill record. Categories and counts only, never copies of personal data.
/// Closer ≠ reporter and closure needs lessons (DB checks).
model BreachRecord {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  /// BRE-YYYY-NNNNNN
  reference            String
  title                String
  description          String
  isDrill              Boolean        @default(false) @map("is_drill")
  status               BreachStatus   @default(DETECTED)
  severity             BreachSeverity
  detectedAt           DateTime       @map("detected_at") @db.Timestamptz(3)
  dataCategories       String[]       @default([]) @map("data_categories")
  estimatedSubjects    Int?           @map("estimated_subjects")
  systemsAffected      String?        @map("systems_affected")
  containmentSummary   String?        @map("containment_summary")
  riskAssessment       String?        @map("risk_assessment")
  notificationDecision String?        @map("notification_decision")
  controllerNotifiedAt DateTime?      @map("controller_notified_at") @db.Timestamptz(3)
  regulatorNotifiedAt  DateTime?      @map("regulator_notified_at") @db.Timestamptz(3)
  subjectsNotifiedAt   DateTime?      @map("subjects_notified_at") @db.Timestamptz(3)
  remediationSummary   String?        @map("remediation_summary")
  lessonsLearned       String?        @map("lessons_learned")
  ownerId              String?        @map("owner_id") @db.Uuid
  reportedById         String         @map("reported_by_id") @db.Uuid
  closedById           String?        @map("closed_by_id") @db.Uuid
  closedAt             DateTime?      @map("closed_at") @db.Timestamptz(3)
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner      User?         @relation("BreachOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reportedBy User          @relation("BreachReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  closedBy   User?         @relation("BreachCloser", fields: [closedById], references: [id], onDelete: Restrict)
  events     BreachEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@map("breach_records")
}

/// Append-only, exportable incident timeline.
model BreachEvent {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  breachId       String          @map("breach_id") @db.Uuid
  type           BreachEventType
  fromStatus     BreachStatus?   @map("from_status")
  toStatus       BreachStatus?   @map("to_status")
  note           String
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(3)
  actorId        String          @map("actor_id") @db.Uuid
  evidenceFileId String?         @map("evidence_file_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  breach   BreachRecord @relation(fields: [breachId], references: [id], onDelete: Restrict)
  actor    User         @relation("BreachEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  evidence StoredFile?  @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict)

  @@index([tenantId, breachId, occurredAt])
  @@map("breach_events")
}
