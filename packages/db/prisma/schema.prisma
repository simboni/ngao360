}

/// Append-only agent status history (S13 status history).
model AgentStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  agentId    String       @map("agent_id") @db.Uuid
  fromStatus AgentStatus? @map("from_status")
  toStatus   AgentStatus  @map("to_status")
  reason     String?
  actorId    String       @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  actor  User   @relation("AgentStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, agentId, createdAt])
  @@map("agent_status_events")
}

/// Agent × polling station (by code) × cycle × role × shift (blueprint 6.3, S14).
/// Never deleted: replacement marks the original REPLACED and links the successor.
model Deployment {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  electionCycleId       String           @map("election_cycle_id") @db.Uuid
  agentId               String           @map("agent_id") @db.Uuid
  pollingStationCode    String           @map("polling_station_code")
  countyId              String           @map("county_id") @db.Uuid
  constituencyId        String           @map("constituency_id") @db.Uuid
  wardId                String           @map("ward_id") @db.Uuid
  pollingCentreId       String?          @map("polling_centre_id") @db.Uuid
  role                  DeploymentRole
  shift                 DeploymentShift  @default(FULL_DAY)
  status                DeploymentStatus @default(ASSIGNED)
  supervisorAgentId     String?          @map("supervisor_agent_id") @db.Uuid
  instructions          String?
  confirmedAt           DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  /// Device time of the check-in (as reported); received_at is in deployment_events.
  checkedInAt           DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  checkInLatitude       Decimal?         @map("check_in_latitude") @db.Decimal(9, 6)
  checkInLongitude      Decimal?         @map("check_in_longitude") @db.Decimal(9, 6)
  checkInAccuracyMetres Int?             @map("check_in_accuracy_metres")
  checkedOutAt          DateTime?        @map("checked_out_at") @db.Timestamptz(3)
  replacesDeploymentId  String?          @unique @map("replaces_deployment_id") @db.Uuid
  cancelledReason       String?          @map("cancelled_reason")
  createdById           String           @map("created_by_id") @db.Uuid
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle     @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  agent         Agent             @relation("DeploymentAgent", fields: [agentId], references: [id], onDelete: Restrict)
  supervisor    Agent?            @relation("DeploymentSupervisor", fields: [supervisorAgentId], references: [id], onDelete: Restrict)
  replaces      Deployment?       @relation("DeploymentReplacement", fields: [replacesDeploymentId], references: [id], onDelete: Restrict)
  replacedBy    Deployment?       @relation("DeploymentReplacement")
  createdBy     User              @relation("DeploymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events        DeploymentEvent[]

  // Partial unique indexes (one active deployment per agent+shift, one active
  // chief agent per station+shift) are in the migration SQL.
  @@index([tenantId, electionCycleId, pollingStationCode])
  @@index([tenantId, electionCycleId, agentId])
  @@index([tenantId, electionCycleId, status])
  @@index([tenantId, electionCycleId, wardId])
  @@index([tenantId, electionCycleId, constituencyId])
  @@map("deployments")
}

/// Append-only deployment history (assignment, confirmation, check-in, replacement).
model DeploymentEvent {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  deploymentId     String              @map("deployment_id") @db.Uuid
  type             DeploymentEventType
  fromStatus       DeploymentStatus?   @map("from_status")
  toStatus         DeploymentStatus?   @map("to_status")
  note             String?
  /// Check-in coordinates are kept on the deployment row only; this records that one was given.
  hasLocation      Boolean             @default(false) @map("has_location")
  submittedOffline Boolean             @default(false) @map("submitted_offline")
  clientCreatedAt  DateTime?           @map("client_created_at") @db.Timestamptz(3)
  actorId          String              @map("actor_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  actor      User       @relation("DeploymentEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, deploymentId, createdAt])
  @@map("deployment_events")
}

/// Readiness checklist per polling station (by code) and cycle (S15).
model ReadinessChecklist {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  electionCycleId    String          @map("election_cycle_id") @db.Uuid
  pollingStationCode String          @map("polling_station_code")
  countyId           String          @map("county_id") @db.Uuid
  constituencyId     String          @map("constituency_id") @db.Uuid
  wardId             String          @map("ward_id") @db.Uuid
  pollingCentreId    String?         @map("polling_centre_id") @db.Uuid
  /// Derived from the items (deriveReadinessStatus) on every item change.
  status             ReadinessStatus @default(NOT_STARTED)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
