/// Agent person record (blueprint 6.3, S13). Personal identifiers and contact
/// details are NOT here: they live in agent_sensitive. Masked display values
/// are stored here so lists never read the sensitive table.
model Agent {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  /// AGT-YYYY-NNNNNN
  reference            String
  /// Sign-in account used on the mobile PWA (optional, one agent per user).
  userId               String?           @unique @map("user_id") @db.Uuid
  givenName            String            @map("given_name")
  familyName           String            @map("family_name")
  otherNames           String?           @map("other_names")
  gender               AgentGender?
  homeWardId           String            @map("home_ward_id") @db.Uuid
  homeConstituencyId   String            @map("home_constituency_id") @db.Uuid
  homeCountyId         String            @map("home_county_id") @db.Uuid
  languages            String[]          @default([])
  status               AgentStatus       @default(RECRUITED)
  availability         AgentAvailability @default(AVAILABLE)
  notes                String?
  /// "+254 ••• ••• 678" (derived from agent_sensitive.phone on write).
  phoneMasked          String?           @map("phone_masked")
  /// "••••• 678" (derived from agent_sensitive.national_id_number on write).
  nationalIdMasked     String?           @map("national_id_masked")
  hasMpesaNumber       Boolean           @default(false) @map("has_mpesa_number")
  hasNextOfKin         Boolean           @default(false) @map("has_next_of_kin")
  privacyNoticeVersion String?           @map("privacy_notice_version")
  privacyNoticeAckAt   DateTime?         @map("privacy_notice_ack_at") @db.Timestamptz(3)
  createdById          String            @map("created_by_id") @db.Uuid
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User?                @relation("AgentUser", fields: [userId], references: [id], onDelete: Restrict)
  homeWard       GeographicUnit       @relation("AgentHomeWard", fields: [homeWardId], references: [id], onDelete: Restrict)
  createdBy      User                 @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sensitive      AgentSensitive?
  accreditations AgentAccreditation[]
  trainings      AgentTraining[]
  statusEvents   AgentStatusEvent[]
  deployments    Deployment[]         @relation("DeploymentAgent")
  supervising    Deployment[]         @relation("DeploymentSupervisor")

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, homeWardId])
  @@index([tenantId, homeConstituencyId])
  @@index([tenantId, homeCountyId])
  @@map("agents")
}

/// Agent personal data (sensitive). Read only through the audited reveal
/// endpoint with field.agents.reveal_sensitive; never in lists or exports.
model AgentSensitive {
  agentId               String   @id @map("agent_id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  nationalIdNumber      String?  @map("national_id_number")
  /// E.164, e.g. +2547XXXXXXXX
  phone                 String?
  mpesaNumber           String?  @map("mpesa_number")
  nextOfKinName         String?  @map("next_of_kin_name")
  nextOfKinPhone        String?  @map("next_of_kin_phone")
  nextOfKinRelationship String?  @map("next_of_kin_relationship")
  updatedById           String   @map("updated_by_id") @db.Uuid
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent     Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  updatedBy User   @relation("AgentSensitiveUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("agent_sensitive")
}

/// Accreditation status per agent and election cycle. Recorded, never granted, by NGAO360.
model AgentAccreditation {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  agentId                String              @map("agent_id") @db.Uuid
  electionCycleId        String              @map("election_cycle_id") @db.Uuid
  status                 AccreditationStatus @default(NOT_SUBMITTED)
  accreditationReference String?             @map("accreditation_reference")
  evidenceFileId         String?             @map("evidence_file_id") @db.Uuid
  submittedAt            DateTime?           @map("submitted_at") @db.Timestamptz(3)
  decidedAt              DateTime?           @map("decided_at") @db.Timestamptz(3)
  expiresOn              DateTime?           @map("expires_on") @db.Date
  notes                  String?
  updatedById            String?             @map("updated_by_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  evidenceFile  StoredFile?   @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict)
  updatedBy     User?         @relation("AccreditationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, agentId, electionCycleId])
  @@index([tenantId, electionCycleId, status])
  @@map("agent_accreditations")
}

model AgentTraining {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  agentId         String         @map("agent_id") @db.Uuid
  electionCycleId String?        @map("election_cycle_id") @db.Uuid
  title           String
  status          TrainingStatus @default(SCHEDULED)
  scheduledOn     DateTime?      @map("scheduled_on") @db.Date
  materialsIssued Boolean        @default(false) @map("materials_issued")
  attendedAt      DateTime?      @map("attended_at") @db.Timestamptz(3)
  assessmentScore Int?           @map("assessment_score")
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  refresherDueOn  DateTime?      @map("refresher_due_on") @db.Date
  notes           String?
  recordedById    String         @map("recorded_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
