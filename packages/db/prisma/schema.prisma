// ============================================================================
// Tenancy, identity and access
// ============================================================================

/// Organisation workspace. Not tenant-owned (it IS the tenant); no RLS.
model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique
  name             String
  displayName      String?      @map("display_name")
  type             TenantType
  status           TenantStatus @default(ACTIVE)
  locale           String       @default("en-KE")
  timezone         String       @default("Africa/Nairobi")
  retentionProfile String       @default("standard") @map("retention_profile")
  dataRegion       String       @default("ke") @map("data_region")
  settings         Json         @default("{}")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  roles                Role[]
  rolePermissions      RolePermission[]
  roleAssignments      RoleAssignment[]
  sessions             Session[]
  mfaFactors           MfaFactor[]
  auditEvents          AuditEvent[]
  electionCycles       ElectionCycle[]
  geographicUnits      GeographicUnit[]
  registryVersions     RegistryVersion[]
  registryImports      RegistryImport[]
  pollingStations      PollingStation[]
  tallyCentres         TallyCentre[]
  contests             Contest[]
  candidateReferences  CandidateReference[]
  formTemplates        FormTemplate[]
  storedFiles          StoredFile[]
  resultSubmissions    ResultSubmission[]
  resultValues         ResultValue[]
  resultValueChanges   ResultValueChange[]
  ocrExtractions       OcrExtraction[]
  validationResults    ValidationResult[]
  verifications        Verification[]
  discrepancyCases     DiscrepancyCase[]
  discrepancyCaseLinks DiscrepancyCaseSubmission[]
  discrepancyActions   DiscrepancyCaseAction[]
  tallySnapshots       TallySnapshot[]
  tallyExports         TallyExport[]
  notifications        Notification[]
  referenceSequences   ReferenceSequence[]

  modules                   TenantModule[]
  institutions              Institution[]
  correspondence            Correspondence[]
  correspondenceAttachments CorrespondenceAttachment[]
  appointments              Appointment[]
  meetings                  Meeting[]
  meetingActionItems        MeetingActionItem[]
  meetingDecisions          MeetingDecision[]
  citizenCases              CitizenCase[]
  citizenCaseContacts       CitizenCaseContact[]
  caseEvents                CaseEvent[]
  caseReferrals             CaseReferral[]
  projects                  Project[]
  projectMilestones         ProjectMilestone[]
  projectEvidence           ProjectEvidence[]

  // Field and election operations
  agents               Agent[]
  agentSensitive       AgentSensitive[]
  agentAccreditations  AgentAccreditation[]
  agentTrainings       AgentTraining[]
  agentStatusEvents    AgentStatusEvent[]
  deployments          Deployment[]
  deploymentEvents     DeploymentEvent[]
  readinessChecklists  ReadinessChecklist[]
  readinessItems       ReadinessItem[]
  fieldReportTemplates FieldReportTemplate[]
  fieldReports         FieldReport[]
  fieldReportEvidence  FieldReportEvidence[]
  incidents            Incident[]
  incidentEvents       IncidentEvent[]
  incidentEvidence     IncidentEvidence[]
  incidentSubjects     IncidentSubject[]
  stationStatuses      StationStatus[]
  stationStatusEvents  StationStatusEvent[]
  clientSubmissions    ClientSubmission[]
  fieldFileClaims      FieldFileClaim[]

  // Campaign and organisation
  departments                  Department[]
  teams                        Team[]
  teamMembers                  TeamMember[]
  tasks                        Task[]
  taskCollaborators            TaskCollaborator[]
  taskDependencies             TaskDependency[]
  taskChecklistItems           TaskChecklistItem[]
  taskComments                 TaskComment[]
  taskAttachments              TaskAttachment[]
  taskEvents                   TaskEvent[]
  campaignEvents               CampaignEvent[]
  eventInvitedTeams            EventInvitedTeam[]
  eventAgendaItems             EventAgendaItem[]
  eventLogisticsItems          EventLogisticsItem[]
  eventAttendances             EventAttendance[]
  eventAttendanceContacts      EventAttendanceContact[]
  eventDocuments               EventDocument[]
  eventAfterActionReports      EventAfterActionReport[]
  contentItems                 ContentItem[]
  contentRevisions             ContentRevision[]
  financeAccounts              FinanceAccount[]
  financeCategories            FinanceCategory[]
  financePayees                FinancePayee[]
  contributionSources          ContributionSource[]
  financeBudgetLines           FinanceBudgetLine[]
  financeTransactions          FinanceTransaction[]
  financeTransactionDocuments  FinanceTransactionDocument[]
  financeTransactionEvents     FinanceTransactionEvent[]
  financeLimitSettings         FinanceLimitSetting[]
  reportTemplates              ReportTemplate[]
  reportExports                ReportExport[]
  notificationPreferences      NotificationPreference[]
  notificationDeliveries       NotificationDelivery[]
  notificationAcknowledgements NotificationAcknowledgement[]
  breachRecords                BreachRecord[]
  breachEvents                 BreachEvent[]

  @@map("tenants")
}

model User {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  email                   String
  phone                   String?
  displayName             String     @map("display_name")
  passwordHash            String?    @map("password_hash")
  status                  UserStatus @default(INVITED)
  mfaEnabled              Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt             DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount        Int        @default(0) @map("failed_login_count")
  lockedUntil             DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// Consecutive wrong TOTP codes; reaching MFA_MAX_FAILURES sets mfaLockedUntil.
  failedMfaCount          Int        @default(0) @map("failed_mfa_count")
  mfaLockedUntil          DateTime?  @map("mfa_locked_until") @db.Timestamptz(3)
  /// SHA-256 of the single-use invitation token (the raw token is shown once).
  invitationTokenHash     String?    @unique @map("invitation_token_hash")
  invitationExpiresAt     DateTime?  @map("invitation_expires_at") @db.Timestamptz(3)
  invitedById             String?    @map("invited_by_id") @db.Uuid
  passwordChangedAt       DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  privacyNoticeVersion    String?    @map("privacy_notice_version")
  privacyNoticeAcceptedAt DateTime?  @map("privacy_notice_accepted_at") @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy          User?            @relation("UserInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers       User[]           @relation("UserInviter")
  roleAssignments    RoleAssignment[] @relation("AssignmentUser")
  grantedAssignments RoleAssignment[] @relation("AssignmentGrantedBy")
  revokedAssignments RoleAssignment[] @relation("AssignmentRevokedBy")
  sessions           Session[]
  mfaFactors         MfaFactor[]
  auditEvents        AuditEvent[]
  notifications      Notification[]

  uploadedFiles           StoredFile[]            @relation("FileUploader")
  submissions             ResultSubmission[]      @relation("SubmissionSubmitter")
  confirmedValues         ResultValue[]           @relation("ValueConfirmedBy")
  valueChanges            ResultValueChange[]     @relation("ValueChangeActor")
  verifications           Verification[]          @relation("VerificationReviewer")
  supervisedVerifications Verification[]          @relation("VerificationSupervisor")
  assignedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyAssignee")
  openedDiscrepancies     DiscrepancyCase[]       @relation("DiscrepancyOpener")
  resolvedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyResolver")
  approvedDiscrepancies   DiscrepancyCase[]       @relation("DiscrepancyClosureApprover")
  discrepancyActions      DiscrepancyCaseAction[]
  createdSnapshots        TallySnapshot[]         @relation("SnapshotCreator")
  releasedSnapshots       TallySnapshot[]         @relation("SnapshotReleaser")
  createdExports          TallyExport[]
  approvedTemplates       FormTemplate[]          @relation("TemplateApprover")
  createdTemplates        FormTemplate[]          @relation("TemplateCreator")
  approvedRegistries      RegistryVersion[]       @relation("RegistryApprover")
  registryImports         RegistryImport[]        @relation("RegistryImporter")

  // NGAO360 Office
  updatedModules             TenantModule[]             @relation("ModuleUpdater")
  assignedCorrespondence     Correspondence[]           @relation("CorrespondenceAssignee")
  createdCorrespondence      Correspondence[]           @relation("CorrespondenceCreator")
  correspondenceAttachments  CorrespondenceAttachment[] @relation("CorrespondenceAttachmentAdder")
  assignedAppointments       Appointment[]              @relation("AppointmentAssignee")
  createdAppointments        Appointment[]              @relation("AppointmentCreator")
  ownedMeetings              Meeting[]                  @relation("MeetingOwner")
  minutedMeetings            Meeting[]                  @relation("MeetingMinutesRecorder")
  meetingActionItems         MeetingActionItem[]        @relation("MeetingActionOwner")
  meetingDecisions           MeetingDecision[]          @relation("MeetingDecisionRecorder")
  assignedCases              CitizenCase[]              @relation("CaseAssignee")
  triagedCases               CitizenCase[]              @relation("CaseTriager")
  resolvedCases              CitizenCase[]              @relation("CaseResolutionProposer")
  closedCases                CitizenCase[]              @relation("CaseCloser")
  createdCases               CitizenCase[]              @relation("CaseCreator")
  caseEvents                 CaseEvent[]                @relation("CaseEventActor")
  caseReferrals              CaseReferral[]             @relation("CaseReferrer")
  trackedProjects            Project[]                  @relation("ProjectTrackingOfficer")
  createdProjects            Project[]                  @relation("ProjectCreator")
  reportedProjectCompletions Project[]                  @relation("ProjectCompletionReporter")
  verifiedProjectCompletions Project[]                  @relation("ProjectCompletionVerifier")
  verifiedProjectExpenditure Project[]                  @relation("ProjectExpenditureVerifier")
  publishedProjects          Project[]                  @relation("ProjectPublisher")
  verifiedMilestones         ProjectMilestone[]         @relation("MilestoneVerifier")
  uploadedProjectEvidence    ProjectEvidence[]          @relation("EvidenceUploader")
  verifiedProjectEvidence    ProjectEvidence[]          @relation("EvidenceVerifier")

  // Field and election operations
  agentProfile               Agent?                @relation("AgentUser")
  agentsCreated              Agent[]               @relation("AgentCreatedBy")
  agentSensitiveUpdated      AgentSensitive[]      @relation("AgentSensitiveUpdatedBy")
  agentAccreditationsUpdated AgentAccreditation[]  @relation("AccreditationUpdatedBy")
  agentTrainingsRecorded     AgentTraining[]       @relation("TrainingRecordedBy")
  agentStatusEvents          AgentStatusEvent[]    @relation("AgentStatusActor")
  deploymentsCreated         Deployment[]          @relation("DeploymentCreatedBy")
  deploymentEvents           DeploymentEvent[]     @relation("DeploymentEventActor")
  readinessItemsUpdated      ReadinessItem[]       @relation("ReadinessItemUpdatedBy")
  fieldTemplatesCreated      FieldReportTemplate[] @relation("FieldTemplateCreatedBy")
  fieldTemplatesActivated    FieldReportTemplate[] @relation("FieldTemplateActivatedBy")
  fieldReportsAuthored       FieldReport[]         @relation("FieldReportAuthor")
  fieldReportsReviewed       FieldReport[]         @relation("FieldReportReviewer")
  fieldReportEvidenceAdded   FieldReportEvidence[] @relation("FieldReportEvidenceAddedBy")
  incidentsReported          Incident[]            @relation("IncidentReporter")
  incidentsAssigned          Incident[]            @relation("IncidentAssignee")
  incidentsResolved          Incident[]            @relation("IncidentResolvedBy")
  incidentsClosed            Incident[]            @relation("IncidentClosedBy")
  incidentEvents             IncidentEvent[]       @relation("IncidentEventActor")
  incidentEvidenceAdded      IncidentEvidence[]    @relation("IncidentEvidenceAddedBy")
  incidentSubjectsRecorded   IncidentSubject[]     @relation("IncidentSubjectRecordedBy")
  stationStatusesSet         StationStatus[]       @relation("StationStatusManualBy")
  stationStatusEvents        StationStatusEvent[]  @relation("StationStatusEventActor")
  clientSubmissions          ClientSubmission[]    @relation("ClientSubmissionUser")
  fieldFileClaims            FieldFileClaim[]      @relation("FieldFileClaimUser")

  // Campaign and organisation
  departmentsLed           Department[]                  @relation("DepartmentLead")
  departmentsCreated       Department[]                  @relation("DepartmentCreatedBy")
  teamsCoordinated         Team[]                        @relation("TeamCoordinator")
  teamsCreated             Team[]                        @relation("TeamCreatedBy")
  teamMemberships          TeamMember[]                  @relation("TeamMemberUser")
  teamMembersAdded         TeamMember[]                  @relation("TeamMemberAddedBy")
  teamMembersRemoved       TeamMember[]                  @relation("TeamMemberRemovedBy")
  tasksOwned               Task[]                        @relation("TaskOwner")
  tasksReviewing           Task[]                        @relation("TaskReviewer")
  tasksCreated             Task[]                        @relation("TaskCreatedBy")
  taskCollaborations       TaskCollaborator[]            @relation("TaskCollaboratorUser")
