// Tasks (blueprint 5.2, S08)
// ---------------------------------------------------------------------------

model Task {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  /// TSK-YYYY-NNNNNN
  reference          String
  title              String
  description        String?
  acceptanceCriteria String?         @map("acceptance_criteria")
  /// The one accountable owner (blueprint 5.2).
  ownerId            String          @map("owner_id") @db.Uuid
  reviewerId         String?         @map("reviewer_id") @db.Uuid
  createdById        String          @map("created_by_id") @db.Uuid
  priority           TaskPriority    @default(NORMAL)
  status             TaskStatus      @default(DRAFT)
  startAt            DateTime?       @map("start_at") @db.Timestamptz(3)
  dueAt              DateTime?       @map("due_at") @db.Timestamptz(3)
  departmentId       String?         @map("department_id") @db.Uuid
  teamId             String?         @map("team_id") @db.Uuid
  geographicUnitId   String?         @map("geographic_unit_id") @db.Uuid
  sourceType         TaskSourceType? @map("source_type")
  /// Id of the source record (project, event, incident, case). Polymorphic: no FK.
  sourceId           String?         @map("source_id") @db.Uuid
  sourceLabel        String?         @map("source_label")
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner          User                @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewer       User?               @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  createdBy      User                @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  department     Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit?     @relation("TaskGeography", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  collaborators  TaskCollaborator[]
  dependencies   TaskDependency[]    @relation("TaskDependencies")
  dependents     TaskDependency[]    @relation("TaskDependents")
  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  events         TaskEvent[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, reviewerId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, dueAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("tasks")
}

model TaskCollaborator {
