/// Versioned field report template (schema JSON). ACTIVE templates are immutable.
model FieldReportTemplate {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  key             String
  version         Int
  name            String
  description     String?
  reportType      FieldReportType           @map("report_type")
  status          FieldReportTemplateStatus @default(DRAFT)
  /// FieldReportTemplateSchemaSchema (packages/shared/src/field/reports.ts)
  schema          Json
  electionCycleId String?                   @map("election_cycle_id") @db.Uuid
  createdById     String                    @map("created_by_id") @db.Uuid
  activatedById   String?                   @map("activated_by_id") @db.Uuid
  activatedAt     DateTime?                 @map("activated_at") @db.Timestamptz(3)
  retiredAt       DateTime?                 @map("retired_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle? @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("FieldTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy   User?          @relation("FieldTemplateActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  reports       FieldReport[]

  @@unique([tenantId, key, version])
  @@index([tenantId, status])
  @@map("field_report_templates")
}

/// Field report (S11). Submitted content is immutable (trigger); review fields change.
model FieldReport {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  /// FRP-YYYY-NNNNNN
  reference            String
  templateId           String                  @map("template_id") @db.Uuid
  templateVersion      Int                     @map("template_version")
  reportType           FieldReportType         @map("report_type")
  electionCycleId      String                  @map("election_cycle_id") @db.Uuid
  pollingStationCode   String?                 @map("polling_station_code")
  /// Lowest unit (station's centre/ward, or the area given).
  geographicUnitId     String                  @map("geographic_unit_id") @db.Uuid
  countyId             String?                 @map("county_id") @db.Uuid
  constituencyId       String?                 @map("constituency_id") @db.Uuid
  wardId               String?                 @map("ward_id") @db.Uuid
  pollingCentreId      String?                 @map("polling_centre_id") @db.Uuid
  eventAt              DateTime                @map("event_at") @db.Timestamptz(3)
  receivedAt           DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  answers              Json
  notes                String?
  latitude             Decimal?                @db.Decimal(9, 6)
  longitude            Decimal?                @db.Decimal(9, 6)
  authorId             String                  @map("author_id") @db.Uuid
  submittedOffline     Boolean                 @default(false) @map("submitted_offline")
  clientIdempotencyKey String                  @map("client_idempotency_key") @db.Uuid
  deviceId             String?                 @map("device_id")
  clientCreatedAt      DateTime?               @map("client_created_at") @db.Timestamptz(3)
  supersedesReportId   String?                 @map("supersedes_report_id") @db.Uuid
  reviewStatus         FieldReportReviewStatus @default(SUBMITTED) @map("review_status")
  reviewerId           String?                 @map("reviewer_id") @db.Uuid
  reviewNote           String?                 @map("review_note")
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  version              Int                     @default(1)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template       FieldReportTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  electionCycle  ElectionCycle         @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit        @relation("FieldReportUnit", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  author         User                  @relation("FieldReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer       User?                 @relation("FieldReportReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  supersedes     FieldReport?          @relation("FieldReportSupersedes", fields: [supersedesReportId], references: [id], onDelete: Restrict)
  supersededBy   FieldReport[]         @relation("FieldReportSupersedes")
  evidence       FieldReportEvidence[]

  @@unique([tenantId, reference])
  @@unique([tenantId, authorId, clientIdempotencyKey])
  @@index([tenantId, electionCycleId, pollingStationCode])
  @@index([tenantId, electionCycleId, reviewStatus])
  @@index([tenantId, electionCycleId, wardId])
  @@map("field_reports")
}

/// Append-only link between a field report and its evidence files.
model FieldReportEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  storedFileId String   @map("stored_file_id") @db.Uuid
  addedById    String   @map("added_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report     FieldReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  storedFile StoredFile  @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  addedBy    User        @relation("FieldReportEvidenceAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, reportId, storedFileId])
  @@map("field_report_evidence")
}

/// Incident (blueprint 7.3, S17). The original report is immutable (trigger);
/// everything after it is an incident_events row. Never deleted.
model Incident {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  /// INC-YYYY-NNNNNN
  reference            String
  electionCycleId      String                    @map("election_cycle_id") @db.Uuid
  /// As reported (immutable).
  reportedCategory     IncidentCategory          @map("reported_category")
  /// Current category after triage.
  category             IncidentCategory
  /// Initial severity from the configured rules (immutable).
  initialSeverity      IncidentSeverity          @map("initial_severity")
  severity             IncidentSeverity
  status               IncidentStatus            @default(REPORTED)
  outcome              IncidentOutcome?
  occurredAt           DateTime                  @map("occurred_at") @db.Timestamptz(3)
  reportedAt           DateTime                  @default(now()) @map("reported_at") @db.Timestamptz(3)
  pollingStationCode   String?                   @map("polling_station_code")
  geographicUnitId     String                    @map("geographic_unit_id") @db.Uuid
  countyId             String?                   @map("county_id") @db.Uuid
  constituencyId       String?                   @map("constituency_id") @db.Uuid
  wardId               String?                   @map("ward_id") @db.Uuid
  pollingCentreId      String?                   @map("polling_centre_id") @db.Uuid
  locationDescription  String?                   @map("location_description")
  latitude             Decimal?                  @db.Decimal(9, 6)
  longitude            Decimal?                  @db.Decimal(9, 6)
  /// Neutral factual description as reported (immutable).
  description          String
  sensitivity          SensitivityLevel          @default(INTERNAL)
  reporterId           String                    @map("reporter_id") @db.Uuid
  assigneeId           String?                   @map("assignee_id") @db.Uuid
  escalatedTo          IncidentEscalationTarget? @map("escalated_to")
  evidenceHold         Boolean                   @default(false) @map("evidence_hold")
  duplicateOfId        String?                   @map("duplicate_of_id") @db.Uuid
  resolutionNote       String?                   @map("resolution_note")
  resolvedById         String?                   @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  closureNote          String?                   @map("closure_note")
  closedById           String?                   @map("closed_by_id") @db.Uuid
  closedAt             DateTime?                 @map("closed_at") @db.Timestamptz(3)
  submittedOffline     Boolean                   @default(false) @map("submitted_offline")
  clientIdempotencyKey String                    @map("client_idempotency_key") @db.Uuid
  deviceId             String?                   @map("device_id")
  clientCreatedAt      DateTime?                 @map("client_created_at") @db.Timestamptz(3)
  version              Int                       @default(1)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle  ElectionCycle      @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  geographicUnit GeographicUnit     @relation("IncidentUnit", fields: [geographicUnitId], references: [id], onDelete: Restrict)
  reporter       User               @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee       User?              @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  resolvedBy     User?              @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  closedBy       User?              @relation("IncidentClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  duplicateOf    Incident?          @relation("IncidentDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates     Incident[]         @relation("IncidentDuplicate")
  events         IncidentEvent[]
  evidence       IncidentEvidence[]
  subjects       IncidentSubject[]

  @@unique([tenantId, reference])
  @@unique([tenantId, reporterId, clientIdempotencyKey])
  @@index([tenantId, electionCycleId, status, severity])
  @@index([tenantId, electionCycleId, pollingStationCode])
  @@index([tenantId, electionCycleId, wardId])
  @@index([tenantId, assigneeId, status])
  @@map("incidents")
}

/// Append-only incident history: triage, assignment, escalation, notes,
/// corrections, referrals, evidence holds, resolution, closure, reopening.
model IncidentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  incidentId String            @map("incident_id") @db.Uuid
  type       IncidentEventType
  fromStatus IncidentStatus?   @map("from_status")
  toStatus   IncidentStatus?   @map("to_status")
  note       String?
  /// Structured details (severity change, assignee, escalation target, correction). No personal data.
  data       Json              @default("{}")
  fileIds    String[]          @default([]) @map("file_ids") @db.Uuid
  actorId    String            @map("actor_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actor    User     @relation("IncidentEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, incidentId, createdAt])
  @@map("incident_events")
}

/// Append-only evidence links (original report evidence and later additions).
model IncidentEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  storedFileId String   @map("stored_file_id") @db.Uuid
  original     Boolean  @default(false)
  addedById    String   @map("added_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident   Incident   @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  addedBy    User       @relation("IncidentEvidenceAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, incidentId, storedFileId])
  @@map("incident_evidence")
}

/// Restricted subject of an incident (who or what it concerns), append-only.
/// Readable only with field.incidents.view_subject; every read is audited.
model IncidentSubject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  description  String
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  recordedBy User     @relation("IncidentSubjectRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, incidentId])
  @@map("incident_subjects")
}

/// Current War Room status per polling station (by code) and cycle (blueprint 7.2).
/// Derived from deployments, field reports, incidents and tally intake;
/// commanders may set FLAGGED or CLOSED manually (with a reason).
model StationStatus {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  electionCycleId    String              @map("election_cycle_id") @db.Uuid
  pollingStationCode String              @map("polling_station_code")
  countyId           String              @map("county_id") @db.Uuid
  constituencyId     String              @map("constituency_id") @db.Uuid
  wardId             String              @map("ward_id") @db.Uuid
  pollingCentreId    String?             @map("polling_centre_id") @db.Uuid
  status             OperationalStatus   @default(NOT_ASSIGNED)
  source             StationStatusSource @default(DERIVED)
  /// Last derived status (kept while a manual status is set).
  derivedStatus      OperationalStatus   @default(NOT_ASSIGNED) @map("derived_status")
  manualStatus       OperationalStatus?  @map("manual_status")
  manualNote         String?             @map("manual_note")
  manualSetById      String?             @map("manual_set_by_id") @db.Uuid
  /// Snapshot of the components used for the derived status.
  components         Json                @default("{}")
  computedAt         DateTime            @default(now()) @map("computed_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  electionCycle ElectionCycle        @relation(fields: [electionCycleId], references: [id], onDelete: Restrict)
  manualSetBy   User?                @relation("StationStatusManualBy", fields: [manualSetById], references: [id], onDelete: Restrict)
  events        StationStatusEvent[]

  @@unique([tenantId, electionCycleId, pollingStationCode])
  @@index([tenantId, electionCycleId, status])
  @@index([tenantId, electionCycleId, wardId])
  @@map("station_statuses")
}

/// Append-only station status history.
model StationStatusEvent {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  stationStatusId String              @map("station_status_id") @db.Uuid
  fromStatus      OperationalStatus?  @map("from_status")
  toStatus        OperationalStatus   @map("to_status")
  source          StationStatusSource
  reason          String?
  actorId         String?             @map("actor_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stationStatus StationStatus @relation(fields: [stationStatusId], references: [id], onDelete: Restrict)
  actor         User?         @relation("StationStatusEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, stationStatusId, createdAt])
  @@map("station_status_events")
}

/// Offline-sync idempotency ledger (blueprint 13.4): one row per
/// (tenant, user, client key). A retry with the same key and payload hash
/// returns the recorded result; a different payload is a conflict.
model ClientSubmission {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  deviceId        String                  @map("device_id")
  idempotencyKey  String                  @map("idempotency_key") @db.Uuid
  kind            ClientSubmissionKind
  /// SHA-256 of canonicalPayload(payload).
  payloadHash     String                  @map("payload_hash")
  outcome         ClientSubmissionOutcome
  resultType      String?                 @map("result_type")
  resultId        String?                 @map("result_id") @db.Uuid
  resultReference String?                 @map("result_reference")
  errorCode       String?                 @map("error_code")
  clientCreatedAt DateTime?               @map("client_created_at") @db.Timestamptz(3)
  attempts        Int                     @default(1)
  firstSeenAt     DateTime                @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime                @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation("ClientSubmissionUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, userId, deviceId, lastSeenAt])
  @@index([tenantId, outcome, lastSeenAt])
  @@map("client_submissions")
}

/// Who uploaded a content-addressed stored file for a field purpose. Identical bytes
/// are stored once per tenant (stored_files is unique on sha256), so the first
/// uploader alone is on stored_files.uploaded_by_id; every uploader gets a claim here,
/// and field evidence is authorised by claim, not by the first uploader. Append-only.
model FieldFileClaim {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  storedFileId String            @map("stored_file_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  purpose      StoredFilePurpose
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  user       User       @relation("FieldFileClaimUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, storedFileId, userId, purpose])
  @@index([tenantId, userId])
  @@map("field_file_claims")
}

