// NGAO360 database schema: platform foundation + NGAO TALLY.
//
// Conventions
// - UUID primary keys everywhere (blueprint 14.1). Official external codes live in separate fields.
// - Every tenant-owned table has a `tenant_id` column and a Postgres row-level security policy
//   keyed on the session setting `app.tenant_id` (see migrations/*_rls_and_integrity).
// - Enum values must match packages/shared/src/enums.ts (checked by a unit test).
// - Append-only tables (audit_events, result_value_changes, discrepancy_case_actions) and
//   immutable tables (stored_files, tally_snapshots) are protected by database triggers.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

