{
  "name": "ngao360",
  "private": true,
  "version": "0.1.0",
  "description": "NGAO360 operations platform: foundation and NGAO TALLY parallel recordkeeping",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ngao360/db run generate",
    "db:migrate": "pnpm --filter @ngao360/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @ngao360/db run migrate:dev",
    "db:seed": "pnpm --filter @ngao360/db run seed",
    "db:reset": "pnpm --filter @ngao360/db run reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "test:rehearsal": "pnpm --filter @ngao360/api run test:rehearsal",
    "test:rehearsal:office": "pnpm --filter @ngao360/api run test:rehearsal:office",
    "test:rehearsal:field": "pnpm --filter @ngao360/api run test:rehearsal:field",
    "test:rehearsal:campaign": "pnpm --filter @ngao360/api run test:rehearsal:campaign",
    "test:rehearsal:pilot": "pnpm --filter @ngao360/api run test:rehearsal:pilot",
    "smoke:web": "node scripts/smoke/web-smoke.cjs",
    "fixtures:forms": "python3 scripts/fixtures/generate-form-images.py",
    "smoke:office": "node scripts/smoke/office-smoke.cjs",
    "smoke:field": "node scripts/smoke/field-smoke.cjs",
    "smoke:campaign": "node scripts/smoke/campaign-smoke.cjs",
    "smoke:pilot": "node scripts/smoke/pilot-smoke.cjs",
    "smoke:golive": "node scripts/smoke/golive-smoke.cjs",
    "smoke:golive-gaps": "node scripts/smoke/golive-gaps-smoke.cjs",
    "demo:2022-bungoma": "turbo run build --filter=@ngao360/api --output-logs=errors-only && pnpm --filter @ngao360/api run demo:2022-bungoma",
    "demo:import-34a": "turbo run build --filter=@ngao360/api --output-logs=errors-only && pnpm --filter @ngao360/api run demo:import-34a",
    "demo:redact-34a": "turbo run build --filter=@ngao360/api --output-logs=errors-only && pnpm --filter @ngao360/api run demo:redact-34a",
    "test:demo-2022": "pnpm --filter @ngao360/api run test:demo-2022",
    "fixtures:demo-2022": "node scripts/fixtures/generate-demo-2022-fixtures.mjs",
    "ops:rotate-keys": "pnpm --filter @ngao360/api run ops:rotate-keys"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
