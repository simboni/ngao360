# Secrets for docker-compose.yml. Copy to .env.docker and replace every value.
NGAO_DOMAIN=localhost
POSTGRES_PASSWORD=change-me-owner
NGAO_APP_DB_PASSWORD=change-me-app
MINIO_ROOT_USER=ngao-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
S3_BUCKET=ngao360
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# openssl rand -base64 32  (outbox addresses, push endpoints, one-time payloads)
MESSAGING_ENCRYPTION_KEY=
# openssl rand -base64 48  (keyed address hashes)
MESSAGING_HASH_KEY=
# Providers (see .env.example for every variable). Defaults send nothing: log | log | log | none | none
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_DLR_TOKEN=
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
MALWARE_SCANNER=none
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
