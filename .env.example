# ---------------------------------------------------------------------------
# NGAO360 local development environment. Copy to .env and adjust.
# Local Postgres used by the foundation build: a throwaway cluster on port 5433
# (see docs/DEVELOPMENT.md). Docker Compose uses port 5432 inside the network.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Schema owner: migrations + seed (bypasses RLS as table owner)
DATABASE_URL=postgresql://ngao:ngao_dev_owner@127.0.0.1:5433/ngao360?schema=public
# Runtime API role: RLS enforced (not owner, NOBYPASSRLS)
APP_DATABASE_URL=postgresql://ngao_app:ngao_dev_app@127.0.0.1:5433/ngao360?schema=public
# Integration tests (optional; tests skip DB checks when unset)
TEST_DATABASE_URL=postgresql://ngao:ngao_dev_owner@127.0.0.1:5433/ngao360_test?schema=public
TEST_APP_DATABASE_URL=postgresql://ngao_app:ngao_dev_app@127.0.0.1:5433/ngao360_test?schema=public

REDIS_URL=redis://127.0.0.1:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# 32-byte key, base64. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=ZGV2LW1mYS1rZXktMzItYnl0ZXMtbG9uZy0hISEhISE=
MFA_ISSUER=NGAO360
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ngao360-dev
S3_ACCESS_KEY_ID=ngao
S3_SECRET_ACCESS_KEY=ngao_dev_minio
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Rate limiting (requests per window)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Public portal limiter (per client IP and tenant, per window); separate from the global throttler
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=600
PUBLIC_SUBMIT_RATE_LIMIT_MAX=5
PUBLIC_TRACK_RATE_LIMIT_MAX=30
PUBLIC_READ_RATE_LIMIT_MAX=600

# OCR drafts: none (manual capture) | stub (synthetic low-confidence drafts, development only)
OCR_PROVIDER=none

# Queues: set to false to run the API without Redis (e.g. some tests)
QUEUES_ENABLED=true

# Office retention job (minutes between runs; 0 = off)
OFFICE_RETENTION_INTERVAL_MINUTES=360

# Web
NEXT_PUBLIC_APP_NAME=NGAO360
API_INTERNAL_URL=http://localhost:4000

# Seed (synthetic demo data only)
SEED_DEMO_PASSWORD=Demo-Password-2027
# disabled (privileged users enrol TOTP at first sign-in) | preenrolled (shared dev TOTP secret, never in production)
SEED_DEMO_MFA=disabled

# Auth hardening: TOTP lockout (independent of the per-IP throttle) and invitation lifetime
MFA_MAX_FAILURES=5
MFA_LOCK_MINUTES=15
INVITATION_TTL_HOURS=72
