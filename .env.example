# ---------------------------------------------------------------------------
# NGAO360 local development environment. Copy to .env and adjust.
# Local Postgres used by the foundation build: a throwaway cluster on port 5433
# (see docs/DEVELOPMENT.md). Docker Compose uses port 5432 inside the network.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Schema owner: migrations + seed (bypasses RLS as table owner)
DATABASE_URL=postgresql://ngao:ngao_dev_owner@127.0.0.1:5433/ngao360?schema=public
# Runtime API role: RLS enforced (not owner, NOBYPASSRLS)
APP_DATABASE_URL=postgresql://ngao_app:ngao_dev_app@127.0.0.1:5433/ngao360?schema=public
# Integration tests (optional; tests skip DB checks when unset)
TEST_DATABASE_URL=postgresql://ngao:ngao_dev_owner@127.0.0.1:5433/ngao360_test?schema=public
TEST_APP_DATABASE_URL=postgresql://ngao_app:ngao_dev_app@127.0.0.1:5433/ngao360_test?schema=public

REDIS_URL=redis://127.0.0.1:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# 32-byte key, base64. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=ZGV2LW1mYS1rZXktMzItYnl0ZXMtbG9uZy0hISEhISE=
MFA_ISSUER=NGAO360
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ngao360-dev
S3_ACCESS_KEY_ID=ngao
S3_SECRET_ACCESS_KEY=ngao_dev_minio
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Rate limiting (requests per window)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Public portal limiter (per client IP and tenant, per window); separate from the global throttler
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=600
PUBLIC_SUBMIT_RATE_LIMIT_MAX=5
PUBLIC_TRACK_RATE_LIMIT_MAX=30
PUBLIC_READ_RATE_LIMIT_MAX=600

# OCR drafts: none (manual capture) | stub (synthetic low-confidence drafts, development only)
OCR_PROVIDER=none

# Queues: set to false to run the API without Redis (e.g. some tests)
QUEUES_ENABLED=true

# Office retention job (minutes between runs; 0 = off)
OFFICE_RETENTION_INTERVAL_MINUTES=360

# Web
NEXT_PUBLIC_APP_NAME=NGAO360
API_INTERNAL_URL=http://localhost:4000

# Seed (synthetic demo data only)
SEED_DEMO_PASSWORD=Demo-Password-2027
# disabled (privileged users enrol TOTP at first sign-in) | preenrolled (shared dev TOTP secret, never in production)
SEED_DEMO_MFA=disabled

# Auth hardening: TOTP lockout (independent of the per-IP throttle) and invitation lifetime
MFA_MAX_FAILURES=5
MFA_LOCK_MINUTES=15
INVITATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Pilot hardening (docs/ARCHITECTURE.md §16, docs/DEVELOPMENT.md "Providers").
# Every provider defaults to the log / no-op one: nothing leaves the machine.
# Secrets live only here (never in the database, never in logs, never returned
# by the API). A provider that is selected but missing a variable stops the API
# at start-up. Tests use in-process fakes, never the real vendors.
# ---------------------------------------------------------------------------
# Outbox encryption (32-byte base64) and address-hash key (>= 32 chars). Required in
# production and whenever a non-log provider is selected.
#   openssl rand -base64 32   /   openssl rand -base64 48
MESSAGING_ENCRYPTION_KEY=
MESSAGING_HASH_KEY=
MESSAGING_DISPATCH_INTERVAL_SECONDS=30
MESSAGING_MAX_ATTEMPTS=5

# E-mail: log | smtp (only to verified addresses). STARTTLS is required unless SMTP_SECURE=true
# (implicit TLS, usually port 465) or the relay is on loopback. Once smtp is configured,
# invitation and recovery links go to the person by e-mail and are never shown to an administrator.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=NGAO360
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# SMS: log | africastalking (only to verified, consented, not opted-out numbers)
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Approved alphanumeric sender id (approval takes ~2-14 business days); empty = shared short code
AFRICASTALKING_SENDER_ID=
# Live: https://api.africastalking.com  Sandbox: https://api.sandbox.africastalking.com
AFRICASTALKING_BASE_URL=https://api.africastalking.com
# Random path token (>= 24 chars) in the callback URLs to register with Africa's Talking:
#   delivery reports  https://<host>/api/webhooks/sms/africastalking/<token>/delivery
#   inbound SMS       https://<host>/api/webhooks/sms/africastalking/<token>/inbound  (STOP replies opt out)
# The vendor does not sign callbacks; a wrong or missing token answers 404.
AFRICASTALKING_DLR_TOKEN=

# Web Push for the PWA: log | webpush (VAPID keys: npx web-push generate-vapid-keys)
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push services
VAPID_SUBJECT=

# Malware scanning: none | clamd. With none, uploads stay PENDING and cannot be
# published or used where CLEAN is required (fail closed).
# Docker: run the clamd service with `--profile scanner` and set CLAMD_HOST=clamd.
MALWARE_SCANNER=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=15000
SCAN_INTERVAL_SECONDS=60

# Captcha for the public portal: none | hcaptcha | turnstile. A tenant that selects a
# provider which is not configured here, or whose verification fails, refuses submissions.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# Tests only: point verification at a local fake server
CAPTCHA_VERIFY_URL=
CAPTCHA_TIMEOUT_MS=5000

# Rate-limit counters: memory (one API instance, development) | redis (shared across instances;
# uses REDIS_URL). NODE_ENV=production always uses Redis. If Redis is unreachable, limited
# endpoints answer 503 rather than running unlimited.
RATE_LIMIT_STORE=memory

# Durable repeatable jobs on BullMQ with job_runs records (needs QUEUES_ENABLED=true)
JOBS_ENABLED=true

# Passkeys (WebAuthn): relying-party id = registrable domain of the web origin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NGAO360
# Comma-separated allowed origins (default: WEB_ORIGIN)
WEBAUTHN_ORIGINS=
