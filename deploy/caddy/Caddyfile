# NGAO360 production reverse proxy (docker-compose.prod.yml). Set NGAO_DOMAIN for automatic TLS.

# Extra host names (NGAO_REDIRECT_DOMAINS, comma-separated, e.g. "ngao360.co.ke, www.ngao360.co.ke")
# redirect permanently to NGAO_DOMAIN with the path kept. When the variable is empty the block binds a
# placeholder plain-HTTP name that no client ever sends, so no certificate is requested for it.
{$NGAO_REDIRECT_DOMAINS:http://redirect.invalid} {
	redir https://{$NGAO_DOMAIN}{uri} permanent
}

# API replicas are discovered by DNS (`dynamic a`), so `--scale api=N` needs no change here.
{$NGAO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Result-form uploads are limited to 25 MB by the API.
	request_body {
		max_size 30MB
	}

	handle /api/* {
		# Africa's Talking callbacks authenticate by a secret path token: accept them only from the
		# vendor's published source addresses (AT_WEBHOOK_ALLOWED_IPS, space-separated CIDRs; the
		# default allows any). `respond` runs before `reverse_proxy` inside this block.
		@at_webhook_blocked {
			path /api/webhooks/sms/africastalking/*
			not remote_ip {$AT_WEBHOOK_ALLOWED_IPS:0.0.0.0/0 ::/0}
		}
		respond @at_webhook_blocked 403

		reverse_proxy {
			dynamic a api 4000 {
				refresh 10s
			}
			lb_policy least_conn
			health_uri /api/health
			health_interval 10s
			# Retry another replica when one is restarting (idempotent methods only by default).
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Never log cookies, authorization headers or the CSRF token.
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				# The SMS callback path carries a secret token (AFRICASTALKING_DLR_TOKEN): redact it.
				request>uri regexp ^(/api/webhooks/sms/[a-z]+/)[^/?]+ ${1}REDACTED
			}
		}
	}
}
