# NGAO360 production reverse proxy (docker-compose.prod.yml). Set NGAO_DOMAIN for automatic TLS.
# API replicas are discovered by DNS (`dynamic a`), so `--scale api=N` needs no change here.
{$NGAO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Result-form uploads are limited to 25 MB by the API.
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy {
			dynamic a api 4000 {
				refresh 10s
			}
			lb_policy least_conn
			health_uri /api/health
			health_interval 10s
			# Retry another replica when one is restarting (idempotent methods only by default).
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
		# Never log cookies or authorization headers.
		format filter {
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Csrf-Token delete
		}
	}
}
