# Secrets and settings for docker-compose.prod.yml. Copy OUTSIDE the repository, e.g.
#   install -m 600 deploy/env.prod.example /etc/ngao360/.env.prod
# and pass `--env-file /etc/ngao360/.env.prod` (never commit it; .env.prod is git- and docker-ignored
# should it end up in the checkout anyway). Replace
# every value, keep the file mode 600 and store a copy in the secrets vault (docs/RUNBOOKS.md).
# Public host name of the application (web app, API under /api and the citizen portal under /p/<org>).
NGAO_DOMAIN=app.ngao360.co.ke
# Comma-separated host names that redirect permanently to NGAO_DOMAIN, keeping the path
# (so https://ngao360.co.ke/p/<org> lands on the portal). Leave empty to serve none.
NGAO_REDIRECT_DOMAINS=ngao360.co.ke, www.ngao360.co.ke
# Passkey relying-party id: the registrable domain. Must be NGAO_DOMAIN or a parent of it.
NGAO_WEBAUTHN_RP_ID=ngao360.co.ke
NGAO_VERSION=latest

# Postgres: superuser (administrators only, never given to a container), the non-superuser schema
# owner (migrations and backups) and the runtime RLS role (API and worker)
POSTGRES_PASSWORD=
NGAO_OWNER_DB_PASSWORD=
NGAO_APP_DB_PASSWORD=
APP_DB_POOL_SIZE=20

# Redis (password required)
REDIS_PASSWORD=

# MinIO root (console / init only; never given to the API)
MINIO_ROOT_USER=ngao-minio-root
MINIO_ROOT_PASSWORD=
# Bucket for originals, created WITH Object Lock by minio-init
S3_BUCKET=ngao360-originals
S3_REGION=us-east-1
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_DAYS=2555
# Scoped application user (write + read, no delete) and read-only backup user
S3_APP_ACCESS_KEY_ID=ngao-app
S3_APP_SECRET_ACCESS_KEY=
S3_BACKUP_ACCESS_KEY_ID=ngao-backup
S3_BACKUP_SECRET_ACCESS_KEY=

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=
MESSAGING_ENCRYPTION_KEY=
# openssl rand -base64 48
MESSAGING_HASH_KEY=
# openssl rand -base64 32  (agent personal data, column-level encryption)
AGENT_DATA_KEY=
# Only during a key rotation (docs/RUNBOOKS.md "Key rotation"); empty otherwise.
AGENT_DATA_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY_PREVIOUS=
MESSAGING_ENCRYPTION_KEY_PREVIOUS=
MESSAGING_HASH_KEY_PREVIOUS=
# Set to the old MFA_ENCRYPTION_KEY before rotating it (campaign identifier fingerprints).
IDENTIFIER_FINGERPRINT_KEY=

# Providers: every one defaults to the log / no-op provider (nothing leaves the host).
# Configure SMTP before a pilot: until then invitation links are shown once to the inviter.
EMAIL_PROVIDER=log
# Send from a subdomain so mail reputation is kept apart from the main domain (docs/DEPLOYMENT.md §3).
EMAIL_FROM_ADDRESS=no-reply@notify.ngao360.co.ke
EMAIL_FROM_NAME=NGAO360
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_DLR_TOKEN=
# Anonymous portal acknowledgements (SMS pumping / harassment limits): SMS only to these E.164
# prefixes (comma-separated); per-address and per-organisation daily caps (shared rate-limit store).
# With a paid SMS provider configured, SMS acknowledgements also need a portal captcha.
CITIZEN_SMS_ALLOWED_PREFIXES=+254
CITIZEN_MESSAGES_PER_DESTINATION_PER_DAY=3
CITIZEN_SMS_DAILY_BUDGET_PER_TENANT=200
# Caddy: space-separated CIDRs allowed to call the SMS delivery-report webhook (the vendor's
# published callback addresses). Empty = any source (the path token still authenticates).
AT_WEBHOOK_ALLOWED_IPS=
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Tuning (docs/OPERATIONS.md, RUNBOOKS §4)
TALLY_AGGREGATE_MAX_STALE_SECONDS=0
RATE_LIMIT_MAX=300

# Backups (scripts/ops/backup.sh via `--profile ops run --rm backup`)
BACKUP_HOST_DIR=/srv/ngao360/backups
