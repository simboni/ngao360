# Secrets and settings for docker-compose.prod.yml. Copy to .env.prod (never commit it), replace
# every value, keep the file mode 600 and store a copy in the secrets vault (docs/RUNBOOKS.md).
NGAO_DOMAIN=ngao360.example.org
NGAO_VERSION=latest

# Postgres: owner (migrations) and runtime RLS role
POSTGRES_PASSWORD=
NGAO_APP_DB_PASSWORD=
APP_DB_POOL_SIZE=20

# Redis (password required)
REDIS_PASSWORD=

# MinIO root (console / init only; never given to the API)
MINIO_ROOT_USER=ngao-minio-root
MINIO_ROOT_PASSWORD=
# Bucket for originals, created WITH Object Lock by minio-init
S3_BUCKET=ngao360-originals
S3_REGION=us-east-1
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_DAYS=2555
# Scoped application user (write + read, no delete) and read-only backup user
S3_APP_ACCESS_KEY_ID=ngao-app
S3_APP_SECRET_ACCESS_KEY=
S3_BACKUP_ACCESS_KEY_ID=ngao-backup
S3_BACKUP_SECRET_ACCESS_KEY=

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=
MESSAGING_ENCRYPTION_KEY=
# openssl rand -base64 48
MESSAGING_HASH_KEY=

# Providers: every one defaults to the log / no-op provider (nothing leaves the host).
# Configure SMTP before a pilot: until then invitation links are shown once to the inviter.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_DLR_TOKEN=
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Tuning (docs/OPERATIONS.md, RUNBOOKS §4)
TALLY_AGGREGATE_MAX_STALE_SECONDS=0
RATE_LIMIT_MAX=300

# Backups (scripts/ops/backup.sh via `--profile ops run --rm backup`)
BACKUP_HOST_DIR=/srv/ngao360/backups
