{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NgaoAppBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::BUCKET"]
    },
    {
      "Sid": "NgaoAppObjectsWriteOnceRead",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:PutObjectRetention", "s3:GetObjectRetention"],
      "Resource": ["arn:aws:s3:::BUCKET/*"]
    }
  ]
}
