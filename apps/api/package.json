{
  "name": "@ngao360/api",
  "version": "0.1.0",
  "private": true,
  "description": "NGAO360 NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "dotenv -e ../../.env -- jest test/",
    "test:rehearsal": "dotenv -e ../../.env -- jest test/governor-rehearsal",
    "test:rehearsal:office": "dotenv -e ../../.env -- jest test/office-governor-rehearsal",
    "test:rehearsal:field": "dotenv -e ../../.env -- jest test/election-day-rehearsal",
    "test:rehearsal:campaign": "dotenv -e ../../.env -- jest test/campaign-rehearsal",
    "demo:2022-bungoma": "dotenv -e ../../.env -- node dist/demo-2022/cli/demo-2022-bungoma.js",
    "demo:import-34a": "dotenv -e ../../.env -- node dist/demo-2022/cli/import-34a.js",
    "demo:redact-34a": "dotenv -e ../../.env -- node dist/demo-2022/cli/redact-34a.js",
    "test:demo-2022": "dotenv -e ../../.env -- jest test/demo-2022 test/demo-34a"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.913.0",
    "@aws-sdk/s3-request-presigner": "3.913.0",
    "@nestjs/bullmq": "11.0.3",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@ngao360/db": "workspace:*",
    "@ngao360/shared": "workspace:*",
    "@simplewebauthn/server": "13.2.2",
    "argon2": "0.44.0",
    "bullmq": "5.61.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.1",
    "nodemailer": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@ngao360/config": "workspace:*",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "6.0.3",
    "@types/web-push": "3.6.4",
    "dotenv-cli": "10.0.0",
    "eslint": "9.38.0",
    "jest": "29.7.0",
    "smtp-server": "3.21.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
